      },
      "id": "openai-gemini-model",
      "name": "Gemini 3.8 Flash (Ultra-Fast)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        860,
        500
      ]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Webhook (React Native App)').item.json.body?.userId || 'mohamed-kardad' }}",
        "contextWindowLength": 6
      },
      "id": "memory-buffer",
      "name": "Conversation Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        980,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash-tts:generateContent?key=AQ.Ab8RN6LOuDp4wptXHZ649V_q8FMUQxXWYNyDaUeRS8qOgJmluQ",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"{{ $json.output.replace(/\"/g, '\\\"').replace(/\\n/g, ' ') }}\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseModalities\": [\"AUDIO\"],\n    \"speechConfig\": {\n      \"voiceConfig\": {\n        \"prebuiltVoiceConfig\": {\n          \"voiceName\": \"Aoede\"\n        }\n      }\n    }\n  }\n}",
        "options": {}
      },
      "id": "gemini-38-flash-tts",
      "name": "Gemini 3.8 Flash TTS (Voix Aoede - Douce & Jeune)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({\n  status: 'success',\n  reply: $('Aya (AI Agent)').first().json.output,\n  audioBase64: $json.candidates[0].content.parts[0].inlineData.data,\n  mimeType: $json.candidates[0].content.parts[0].inlineData.mimeType || 'audio/wav',\n  timestamp: new Date().toISOString()\n}) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
