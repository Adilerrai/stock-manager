<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bon_livraison_client" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- Paramètres Entreprise / Tenant -->
    <parameter name="logoImage" class="java.awt.Image"/>
    <parameter name="nomEntreprise" class="java.lang.String"/>
    <parameter name="activiteEntreprise" class="java.lang.String"/>
    <parameter name="adresseEntreprise" class="java.lang.String"/>
    <parameter name="telephoneEntreprise" class="java.lang.String"/>
    <parameter name="telephoneSecondaire" class="java.lang.String"/>
    <parameter name="gsmEntreprise" class="java.lang.String"/>
    <parameter name="emailEntreprise" class="java.lang.String"/>
    <parameter name="rcEntreprise" class="java.lang.String"/>
    <parameter name="nifEntreprise" class="java.lang.String"/>
    <parameter name="nisEntreprise" class="java.lang.String"/>
    <parameter name="iceEntreprise" class="java.lang.String"/>
    <parameter name="aiEntreprise" class="java.lang.String"/>
    <parameter name="patenteEntreprise" class="java.lang.String"/>
    <parameter name="cnssEntreprise" class="java.lang.String"/>
    <parameter name="piedPage" class="java.lang.String"/>
    <parameter name="devise" class="java.lang.String"/>

    <!-- Paramètres BL -->
    <parameter name="numeroBl" class="java.lang.String"/>
    <parameter name="dateBl" class="java.lang.String"/>
    <parameter name="statut" class="java.lang.String"/>
    <parameter name="commandeReference" class="java.lang.String"/>
    <parameter name="depotNom" class="java.lang.String"/>
    <parameter name="chauffeurNom" class="java.lang.String"/>
    <parameter name="vehiculeImmatriculation" class="java.lang.String"/>
    <parameter name="notes" class="java.lang.String"/>

    <!-- Paramètres Client -->
    <parameter name="clientNom" class="java.lang.String"/>
    <parameter name="clientTelephone" class="java.lang.String"/>
    <parameter name="clientAdresse" class="java.lang.String"/>
    <parameter name="clientIce" class="java.lang.String"/>

    <!-- Totaux -->
    <parameter name="montantTotal" class="java.math.BigDecimal"/>

    <!-- Champs des lignes de BL -->
    <field name="produitReference" class="java.lang.String"/>
    <field name="produitDesignation" class="java.lang.String"/>
    <field name="depotNom" class="java.lang.String"/>
    <field name="quantiteLivree" class="java.math.BigDecimal"/>
    <field name="prixVente" class="java.math.BigDecimal"/>

    <!-- Group Header avec le même bleu ciel uni pour les colonnes -->
    <group name="ArticlesGroup" minHeightToStartNewPage="50">
        <groupHeader>
            <band height="24">
                <rectangle radius="5">
                    <reportElement x="0" y="0" width="555" height="24" backcolor="#0284C7"/>
                    <graphicElement><pen lineWidth="0"/></graphicElement>
                </rectangle>
                <staticText>
                    <reportElement x="8" y="0" width="80" height="24" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                    <text><![CDATA[RÉFÉRENCE]]></text>
                </staticText>
                <staticText>
                    <reportElement x="92" y="0" width="205" height="24" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                    <text><![CDATA[DÉSIGNATION MARCHANDISE]]></text>
                </staticText>
                <staticText>
                    <reportElement x="300" y="0" width="65" height="24" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                    <text><![CDATA[DÉPÔT]]></text>
                </staticText>
                <staticText>
                    <reportElement x="368" y="0" width="55" height="24" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                    <text><![CDATA[QTÉ]]></text>
                </staticText>
                <staticText>
                    <reportElement x="426" y="0" width="55" height="24" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                    <text><![CDATA[P.U. HT]]></text>
                </staticText>
                <staticText>
                    <reportElement x="484" y="0" width="63" height="24" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                    <text><![CDATA[TOTAL HT]]></text>
                </staticText>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="146">
            <!-- Logo ou Nom Entreprise -->
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="0" y="0" width="115" height="50"/>
                <imageExpression><![CDATA[$P{logoImage}]]></imageExpression>
            </image>

            <textField isBlankWhenNull="true">
                <reportElement x="125" y="8" width="235" height="22" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{nomEntreprise}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="125" y="30" width="235" height="14" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{activiteEntreprise}]]></textFieldExpression>
            </textField>

            <!-- Badge Document (Même bleu ciel unifié avec coins arrondis) -->
            <rectangle radius="6">
                <reportElement x="370" y="0" width="185" height="54" backcolor="#0284C7"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="375" y="4" width="175" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[BON DE LIVRAISON]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="375" y="20" width="175" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{numeroBl}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="375" y="36" width="175" height="14" forecolor="#E0F2FE"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA["Date: " + $P{dateBl}]]></textFieldExpression>
            </textField>

            <!-- Ligne de séparation fine en bleu ciel -->
            <line>
                <reportElement x="0" y="60" width="555" height="1" forecolor="#BAE6FD"/>
                <graphicElement><pen lineWidth="0.75"/></graphicElement>
            </line>

            <!-- Carte Détails Livraison (Contour bleu ciel, coins arrondis, sans statut) -->
            <rectangle radius="6">
                <reportElement x="0" y="68" width="268" height="66" backcolor="#F8FAFC"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#0284C7"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="12" y="73" width="160" height="14" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[INFORMATIONS LIVRAISON]]></text>
            </staticText>
            <staticText>
                <reportElement x="12" y="93" width="95" height="14" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[Dépôt départ :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="110" y="93" width="145" height="14" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{depotNom} != null ? $P{depotNom} : "Dépôt Principal"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="12" y="111" width="95" height="14" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[Réf. Commande :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="110" y="111" width="145" height="14" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{commandeReference} != null ? $P{commandeReference} : "-"]]></textFieldExpression>
            </textField>

            <!-- Carte Client (Même contour bleu ciel et coins arrondis) -->
            <rectangle radius="6">
                <reportElement x="287" y="68" width="268" height="66" backcolor="#F8FAFC"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#0284C7"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="299" y="73" width="100" height="14" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[CLIENT :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="299" y="89" width="245" height="14" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{clientNom}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="299" y="104" width="245" height="13" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{clientAdresse} != null ? $P{clientAdresse} : ""]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="299" y="117" width="245" height="13" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[($P{clientIce} != null && !$P{clientIce}.trim().isEmpty() ? "ICE : " + $P{clientIce} : "") + ($P{clientTelephone} != null && !$P{clientTelephone}.trim().isEmpty() && !$P{clientTelephone}.equals("-") ? ($P{clientIce} != null && !$P{clientIce}.trim().isEmpty() ? "   -   " : "") + "Tél : " + $P{clientTelephone} : "")]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Détails des articles (Hauteur 16px : 30 lignes max par page) -->
    <detail>
        <band height="16">
            <!-- Ligne séparatrice en bleu ciel très clair -->
            <line>
                <reportElement x="0" y="15" width="555" height="1" forecolor="#E0F2FE"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="8" y="0" width="80" height="15" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{produitReference}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="92" y="0" width="205" height="15" forecolor="#1E293B"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{produitDesignation}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="300" y="0" width="65" height="15" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{depotNom} != null ? $F{depotNom} : "-"]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="368" y="0" width="55" height="15" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{quantiteLivree}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="426" y="0" width="55" height="15" forecolor="#475569"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{prixVente}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="484" y="0" width="63" height="15" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{prixVente} != null && $F{quantiteLivree} != null ? $F{prixVente}.multiply($F{quantiteLivree}) : BigDecimal.ZERO]]></textFieldExpression>
            </textField>

            <!-- Saut de page automatique à 30 articles max par page -->
            <break>
                <reportElement x="0" y="15" width="555" height="1">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 30 == 0]]></printWhenExpression>
                </reportElement>
            </break>
        </band>
    </detail>

    <!-- Pied de page officiel 4 lignes unifié bleu ciel -->
    <pageFooter>
        <band height="62">
            <!-- Ligne de séparation en bleu ciel -->
            <line>
                <reportElement x="0" y="2" width="555" height="1" forecolor="#0284C7"/>
                <graphicElement><pen lineWidth="1"/></graphicElement>
            </line>

            <!-- Pagination discrète en haut à droite -->
            <textField>
                <reportElement x="455" y="4" width="65" height="12" forecolor="#64748B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " / "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="520" y="4" width="35" height="12" forecolor="#64748B"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>

            <!-- Ligne 1 : Raison Sociale -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="16" width="555" height="12" forecolor="#0284C7"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["société " + ($P{nomEntreprise} != null ? $P{nomEntreprise} : "")]]></textFieldExpression>
            </textField>

            <!-- Ligne 2 : Siège Social & Adresse -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="27" width="555" height="11" forecolor="#334155"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["Siège Social : " + ($P{adresseEntreprise} != null ? $P{adresseEntreprise} : "")]]></textFieldExpression>
            </textField>

            <!-- Ligne 3 : RC, IF, PATENTE, ICE, CNSS -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="38" width="555" height="11" forecolor="#334155"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["RC : " + ($P{rcEntreprise} != null && !$P{rcEntreprise}.isEmpty() ? $P{rcEntreprise} : "-") +
"  -  IF : " + ($P{nifEntreprise} != null && !$P{nifEntreprise}.isEmpty() ? $P{nifEntreprise} : "-") +
"  -  PATENTE : " + ($P{patenteEntreprise} != null && !$P{patenteEntreprise}.equals("-") ? $P{patenteEntreprise} : ($P{aiEntreprise} != null ? $P{aiEntreprise} : "-")) +
"  -  ICE : " + ($P{iceEntreprise} != null && !$P{iceEntreprise}.equals("-") ? $P{iceEntreprise} : ($P{nisEntreprise} != null ? $P{nisEntreprise} : "-")) +
"  -  CNSS : " + ($P{cnssEntreprise} != null && !$P{cnssEntreprise}.equals("-") ? $P{cnssEntreprise} : "-")]]></textFieldExpression>
            </textField>

            <!-- Ligne 4 : FIX, GSM, EMAIL -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="49" width="555" height="11" forecolor="#0284C7"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["FIX : " + ($P{telephoneEntreprise} != null && !$P{telephoneEntreprise}.isEmpty() ? $P{telephoneEntreprise} : "-") +
($P{gsmEntreprise} != null && !$P{gsmEntreprise}.trim().isEmpty() ? "   GSM : " + $P{gsmEntreprise} : ($P{telephoneSecondaire} != null && !$P{telephoneSecondaire}.trim().isEmpty() ? "   GSM : " + $P{telephoneSecondaire} : "")) +
($P{emailEntreprise} != null && !$P{emailEntreprise}.trim().isEmpty() ? "  -  EMAIL : " + $P{emailEntreprise} : "")]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Résumé : Signatures & Total avec contour bleu ciel, coins arrondis -->
    <summary>
        <band height="95">
            <!-- Zone Signature Transporteur / Livreur (Gauche) -->
            <rectangle radius="6">
                <reportElement x="0" y="8" width="170" height="78" backcolor="#F8FAFC"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#BAE6FD"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="8" y="14" width="154" height="14" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[VISA LIVREUR]]></text>
            </staticText>
            <staticText>
                <reportElement x="8" y="66" width="154" height="14" forecolor="#94A3B8"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="7" isItalic="true"/></textElement>
                <text><![CDATA[Date &amp; Signature]]></text>
            </staticText>

            <!-- Zone Accusé Réception Client (Milieu) -->
            <rectangle radius="6">
                <reportElement x="180" y="8" width="170" height="78" backcolor="#F8FAFC"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#BAE6FD"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="188" y="14" width="154" height="14" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[RÉCEPTION CLIENT]]></text>
            </staticText>
            <staticText>
                <reportElement x="188" y="66" width="154" height="14" forecolor="#94A3B8"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="7" isItalic="true"/></textElement>
                <text><![CDATA[Cachet, Date &amp; Signature]]></text>
            </staticText>

            <!-- Carte Montant Total (Droite) -->
            <rectangle radius="6">
                <reportElement x="360" y="8" width="195" height="78" backcolor="#F8FAFC"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#0284C7"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="372" y="16" width="90" height="14" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[Nombre d'articles :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="465" y="16" width="80" height="14" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["" + $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>

            <!-- Bannière TOTAL LIVRAISON (Bleu ciel unifié et coins arrondis) -->
            <rectangle radius="5">
                <reportElement x="366" y="44" width="183" height="34" backcolor="#0284C7"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="372" y="46" width="170" height="13" forecolor="#E0F2FE"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[TOTAL LIVRAISON]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="372" y="58" width="170" height="17" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[($P{montantTotal} != null ? $P{montantTotal} : java.math.BigDecimal.ZERO) + " " + $P{devise}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
