					<font fontName="DejaVu Sans" size="7.5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[(($P{isInternational} != null && $P{isInternational}.booleanValue()) ? "INSTRUCTIONS TO BIDDER" : "INSTRUCTIONS & CONDITIONS")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="36" y="23" width="294" height="42" forecolor="#475569" uuid="d3e4f5a6-0027-4000-8000-000000000027"/>
				<textElement verticalAlignment="Top" markup="html">
					<font fontName="DejaVu Sans" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[(($P{isInternational} != null && $P{isInternational}.booleanValue()) ?
"• Please submit your best quotation before the closing date.<br/>• Indicate lead time, warranty, packaging and terms of payment.<br/>• All prices should specify currency and agreed Incoterm." :
"• Prière de nous retourner cette demande complétée avant la date limite.<br/>• Préciser la validité de l'offre, le délai de livraison et les modalités de paiement.<br/>• Indiquer les prix hors taxes selon la devise demandée.")]]></textFieldExpression>
			</textField>

			<!-- Cadre Cachet & Signature Fournisseur (à droite) -->
			<rectangle radius="4">
				<reportElement x="348" y="4" width="219" height="66" backcolor="#FFFFFF" uuid="d3e4f5a6-0028-4000-8000-000000000028"/>
				<graphicElement>
					<pen lineWidth="0.6" lineColor="#CBD5E1"/>
				</graphicElement>
			</rectangle>
			<textField>
				<reportElement x="356" y="8" width="203" height="13" forecolor="#334155" uuid="d3e4f5a6-0029-4000-8000-000000000029"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[(($P{isInternational} != null && $P{isInternational}.booleanValue()) ? "SUPPLIER STAMP & SIGNATURE" : "VISA & CACHET DU FOURNISSEUR")]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="356" y="52" width="203" height="12" forecolor="#94A3B8" uuid="d3e4f5a6-0030-4000-8000-000000000030"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="6" isItalic="true"/>
				</textElement>
				<textFieldExpression><![CDATA[(($P{isInternational} != null && $P{isInternational}.booleanValue()) ? "Date, validity & authorized signature" : "Date, validité de l'offre et signature")]]></textFieldExpression>
			</textField>

			<!-- Ligne de séparation et pied légal -->
			<line>
				<reportElement x="28" y="82" width="539" height="1" forecolor="#1F2937" uuid="d3e4f5a6-0031-4000-8000-000000000031"/>
				<graphicElement>
					<pen lineWidth="0.8"/>
				</graphicElement>
			</line>
			<textField isBlankWhenNull="true">
				<reportElement x="28" y="86" width="539" height="22" forecolor="#1F2937" uuid="d3e4f5a6-0032-4000-8000-000000000032"/>
				<textElement textAlignment="Center" verticalAlignment="Top" markup="html">
					<font fontName="DejaVu Sans" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA["<b>IF</b>: " + ($P{nifEntreprise} != null ? $P{nifEntreprise} : "-") + " - <b>Patente</b>: " + ($P{patenteEntreprise} != null ? $P{patenteEntreprise} : "-") + " - <b>CNSS</b>: " + ($P{cnssEntreprise} != null ? $P{cnssEntreprise} : "-") + " - <b>RC</b>: " + ($P{rcEntreprise} != null ? $P{rcEntreprise} : "-") + " - <b>ICE</b>: " + ($P{iceEntreprise} != null ? $P{iceEntreprise} : "-") + " <b>Email</b>: " + ($P{emailEntreprise} != null ? $P{emailEntreprise} : "-") + " <b>Tel</b>: " + ($P{telephoneEntreprise} != null ? $P{telephoneEntreprise} : "-")]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="447" y="110" width="60" height="11" forecolor="#6B7280" uuid="d3e4f5a6-0033-4000-8000-000000000033"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5"/>
				</textElement>
				<textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " /"]]></textFieldExpression>
