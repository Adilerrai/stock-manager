<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="releve_compte_fournisseur" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- Paramètres Entreprise -->
    <parameter name="logoImage" class="java.awt.Image"/>
    <parameter name="nomEntreprise" class="java.lang.String"/>
    <parameter name="activiteEntreprise" class="java.lang.String"/>
    <parameter name="adresseEntreprise" class="java.lang.String"/>
    <parameter name="telephoneEntreprise" class="java.lang.String"/>
    <parameter name="emailEntreprise" class="java.lang.String"/>
    <parameter name="rcEntreprise" class="java.lang.String"/>
    <parameter name="nifEntreprise" class="java.lang.String"/>
    <parameter name="iceEntreprise" class="java.lang.String"/>
    <parameter name="devise" class="java.lang.String"/>

    <!-- Paramètres Relevé & Fournisseur -->
    <parameter name="fournisseurNom" class="java.lang.String"/>
    <parameter name="fournisseurTelephone" class="java.lang.String"/>
    <parameter name="fournisseurAdresse" class="java.lang.String"/>
    <parameter name="fournisseurIce" class="java.lang.String"/>
    <parameter name="periode" class="java.lang.String"/>

    <!-- Totaux -->
    <parameter name="totalDebit" class="java.math.BigDecimal"/>
    <parameter name="totalCredit" class="java.math.BigDecimal"/>
    <parameter name="soldeFinal" class="java.math.BigDecimal"/>

    <!-- Champs du Relevé -->
    <field name="datePiece" class="java.lang.String"/>
    <field name="referencePiece" class="java.lang.String"/>
    <field name="libelle" class="java.lang.String"/>
    <field name="debit" class="java.math.BigDecimal"/>
    <field name="credit" class="java.math.BigDecimal"/>
    <field name="soldeProgressif" class="java.math.BigDecimal"/>

    <title>
        <band height="145">
            <!-- Logo Entreprise -->
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="0" y="0" width="120" height="55"/>
                <imageExpression><![CDATA[$P{logoImage}]]></imageExpression>
            </image>

            <!-- Infos Entreprise -->
            <textField isBlankWhenNull="true">
                <reportElement x="130" y="0" width="230" height="18" forecolor="#2C3D52"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{nomEntreprise}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="130" y="18" width="230" height="13" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{activiteEntreprise}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="130" y="31" width="230" height="13" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{adresseEntreprise} + " - Tél: " + $P{telephoneEntreprise}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="130" y="44" width="230" height="13" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["RC: " + ($P{rcEntreprise} != null ? $P{rcEntreprise} : "-") + " | ICE: " + ($P{iceEntreprise} != null ? $P{iceEntreprise} : "-")]]></textFieldExpression>
            </textField>

            <!-- Titre Encadré Relevé (#2C3D52 avec coins arrondis radius 8) -->
            <rectangle radius="8">
                <reportElement x="350" y="0" width="205" height="50" backcolor="#2C3D52"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="350" y="6" width="205" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <text><![CDATA[RELEVÉ DE COMPTE FOURNISSEUR]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="350" y="24" width="205" height="14" forecolor="#CBD5E1"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{periode}]]></textFieldExpression>
            </textField>

            <!-- Ligne de séparation fine -->
            <line>
                <reportElement x="0" y="65" width="555" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.75"/></graphicElement>
            </line>

            <!-- Cadre Fiche Fournisseur (radius 8, border #E2E8F0) -->
            <rectangle radius="8">
                <reportElement x="0" y="75" width="365" height="60" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="15" y="80" width="75" height="15" forecolor="#64748B"/>
                <textElement><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Fournisseur :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="95" y="80" width="260" height="15" forecolor="#1E293B"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{fournisseurNom}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="15" y="98" width="75" height="15" forecolor="#64748B"/>
                <textElement><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Adresse :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="95" y="98" width="260" height="15" forecolor="#475569"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{fournisseurAdresse} + " - Tél: " + $P{fournisseurTelephone}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="15" y="115" width="75" height="15" forecolor="#64748B"/>
                <textElement><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[ICE / IF :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="95" y="115" width="260" height="15" forecolor="#2C3D52"/>
                <textElement><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{fournisseurIce} != null ? $P{fournisseurIce} : "-"]]></textFieldExpression>
            </textField>

            <!-- Solde Actuel Dû au Fournisseur (radius 8, border #E2E8F0) -->
            <rectangle radius="8">
                <reportElement x="375" y="75" width="180" height="60" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="380" y="82" width="170" height="14" forecolor="#64748B"/>
                <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[SOLDE NET DÛ AU FOURNISSEUR]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="380" y="100" width="170" height="24" forecolor="#2C3D52"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{soldeFinal} + " " + $P{devise}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <rectangle radius="8">
                <reportElement x="0" y="0" width="555" height="24" backcolor="#2C3D52"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="8" y="4" width="65" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Date]]></text>
            </staticText>
            <staticText>
                <reportElement x="78" y="4" width="85" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[N° Pièce / Réf]]></text>
            </staticText>
            <staticText>
                <reportElement x="168" y="4" width="150" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Libellé de l'opération]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="4" width="75" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Débit (Réglé)]]></text>
            </staticText>
            <staticText>
                <reportElement x="400" y="4" width="75" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Crédit (Achat)]]></text>
            </staticText>
            <staticText>
                <reportElement x="480" y="4" width="70" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Solde dû]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <line>
                <reportElement x="0" y="17" width="555" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="8" y="1" width="65" height="15" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{datePiece}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="78" y="1" width="85" height="15" forecolor="#2C3D52"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{referencePiece}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="168" y="1" width="150" height="15" forecolor="#1E293B"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{libelle}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="320" y="1" width="75" height="15" forecolor="#16A34A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{debit} != null && $F{debit}.compareTo(java.math.BigDecimal.ZERO) > 0 ? $F{debit} : "-"]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="400" y="1" width="75" height="15" forecolor="#1E293B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{credit} != null && $F{credit}.compareTo(java.math.BigDecimal.ZERO) > 0 ? $F{credit} : "-"]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="480" y="1" width="70" height="15" forecolor="#1E293B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{soldeProgressif}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="60">
            <!-- Cadre Totaux fond #F1F5F9 avec radius 8 -->
            <rectangle radius="8">
                <reportElement x="180" y="8" width="375" height="34" backcolor="#F1F5F9"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="190" y="16" width="95" height="18" forecolor="#1E293B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <text><![CDATA[TOTAUX :]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="290" y="16" width="75" height="18" forecolor="#16A34A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{totalDebit}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="375" y="16" width="75" height="18" forecolor="#1E293B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{totalCredit}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="460" y="16" width="85" height="18" forecolor="#2C3D52"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{soldeFinal} + " " + $P{devise}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
