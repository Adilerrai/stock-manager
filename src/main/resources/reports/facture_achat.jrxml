<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="facture_achat" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="18" bottomMargin="18" uuid="99e015aa-44d2-4911-aa9a-e55d61ab6526">

    <style name="zebra" mode="Opaque" backcolor="#FFFFFF">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style mode="Opaque" backcolor="#F1F5F9"/>
        </conditionalStyle>
    </style>

    <!-- Paramètres Entreprise / Tenant -->
    <parameter name="logoImage" class="java.awt.Image"/>
    <parameter name="nomEntreprise" class="java.lang.String"/>
    <parameter name="activiteEntreprise" class="java.lang.String"/>
    <parameter name="adresseEntreprise" class="java.lang.String"/>
    <parameter name="telephoneEntreprise" class="java.lang.String"/>
    <parameter name="telephoneSecondaire" class="java.lang.String"/>
    <parameter name="gsmEntreprise" class="java.lang.String"/>
    <parameter name="emailEntreprise" class="java.lang.String"/>
    <parameter name="rcEntreprise" class="java.lang.String"/>
    <parameter name="nifEntreprise" class="java.lang.String"/>
    <parameter name="nisEntreprise" class="java.lang.String"/>
    <parameter name="iceEntreprise" class="java.lang.String"/>
    <parameter name="aiEntreprise" class="java.lang.String"/>
    <parameter name="patenteEntreprise" class="java.lang.String"/>
    <parameter name="cnssEntreprise" class="java.lang.String"/>
    <parameter name="ribEntreprise" class="java.lang.String"/>
    <parameter name="banqueEntreprise" class="java.lang.String"/>
    <parameter name="formeJuridique" class="java.lang.String"/>
    <parameter name="capitalSocial" class="java.lang.String"/>
    <parameter name="tribunalRc" class="java.lang.String"/>
    <parameter name="piedPage" class="java.lang.String"/>
    <parameter name="devise" class="java.lang.String"/>

    <!-- Paramètres Facture Achat -->
    <parameter name="numeroFacture" class="java.lang.String"/>
    <parameter name="dateFacture" class="java.lang.String"/>
    <parameter name="dateEcheance" class="java.lang.String"/>
    <parameter name="statutFacture" class="java.lang.String"/>
    <parameter name="observations" class="java.lang.String"/>

    <!-- Paramètres Fournisseur -->
    <parameter name="fournisseurNom" class="java.lang.String"/>
    <parameter name="fournisseurTelephone" class="java.lang.String"/>
    <parameter name="fournisseurAdresse" class="java.lang.String"/>
    <parameter name="fournisseurNif" class="java.lang.String"/>
    <parameter name="fournisseurRc" class="java.lang.String"/>
    <parameter name="fournisseurIce" class="java.lang.String"/>

    <!-- Totaux Facture Achat -->
    <parameter name="montantHT" class="java.math.BigDecimal"/>
    <parameter name="montantTVA" class="java.math.BigDecimal"/>
    <parameter name="montantTTC" class="java.math.BigDecimal"/>
    <parameter name="montantEnLettres" class="java.lang.String"/>

    <!-- Champs des lignes de facture achat -->
    <field name="reference" class="java.lang.String"/>
    <field name="designation" class="java.lang.String"/>
    <field name="quantite" class="java.math.BigDecimal"/>
    <field name="prixUnitaireHT" class="java.math.BigDecimal"/>
    <field name="prixUnitaire" class="java.math.BigDecimal"/>
    <field name="tauxTVA" class="java.math.BigDecimal"/>
    <field name="montantHT" class="java.math.BigDecimal"/>
    <field name="montantTTC" class="java.math.BigDecimal"/>
    <field name="montantTotal" class="java.math.BigDecimal"/>

    <variable name="totalQteAchat" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{quantite} != null ? $F{quantite} : java.math.BigDecimal.ZERO]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <!-- En-tête -->
    <pageHeader>
        <band height="190">
            <!-- GAUCHE : Logo & Raison Sociale -->
            <image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="18" width="78" height="52"/>
                <imageExpression><![CDATA[$P{logoImage}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="90" y="18" width="275" height="25" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="17" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{nomEntreprise}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="90" y="44" width="275" height="16" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{activiteEntreprise}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="90" y="61" width="275" height="11" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5"/></textElement>
                <textFieldExpression><![CDATA[$P{adresseEntreprise} != null ? $P{adresseEntreprise} : ""]]></textFieldExpression>
            </textField>

            <!-- DROITE : Titre Document, N°, Date -->
            <staticText>
                <reportElement x="340" y="17" width="215" height="25" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[FACTURE D'ACHAT]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="375" y="43" width="180" height="20" forecolor="#0284C7"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["N° " + ($P{numeroFacture} != null ? $P{numeroFacture} : "-")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="375" y="63" width="180" height="12" forecolor="#64748B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Date : " + ($P{dateFacture} != null ? $P{dateFacture} : "-")]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="82" width="555" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.8"/></graphicElement>
            </line>

            <!-- 3 Boîtes d'informations (h=76) -->
            <rectangle radius="5">
                <reportElement x="0" y="94" width="175" height="76" backcolor="#F8FAFC"/>
                <graphicElement><pen lineWidth="0.7" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <rectangle radius="5">
                <reportElement x="190" y="94" width="175" height="76" backcolor="#F8FAFC"/>
                <graphicElement><pen lineWidth="0.7" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <rectangle radius="5">
                <reportElement x="380" y="94" width="175" height="76" backcolor="#F0F9FF"/>
                <graphicElement><pen lineWidth="0.9" lineColor="#7DD3FC"/></graphicElement>
            </rectangle>

            <!-- Box 1 : FACTURE ACHAT -->
            <staticText>
                <reportElement x="12" y="102" width="150" height="12" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[PIÈCE COMPTABLE]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="12" y="120" width="150" height="15" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["N° : " + ($P{numeroFacture} != null ? $P{numeroFacture} : "-")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="12" y="140" width="150" height="15" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Échéance : " + ($P{dateEcheance} != null ? $P{dateEcheance} : "-")]]></textFieldExpression>
            </textField>

            <!-- Box 2 : STATUT & CONDITIONS -->
            <staticText>
                <reportElement x="202" y="102" width="150" height="12" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[CONDITIONS]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="202" y="120" width="150" height="15" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8.5"/></textElement>
                <textFieldExpression><![CDATA["Statut : " + ($P{statutFacture} != null ? $P{statutFacture} : "COMPTABILISÉE")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="202" y="138" width="150" height="15" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Règlement : Virement bancaire"]]></textFieldExpression>
            </textField>

            <!-- Box 3 : FOURNISSEUR -->
            <staticText>
                <reportElement x="392" y="102" width="150" height="12" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[FOURNISSEUR]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="392" y="120" width="150" height="20" forecolor="#0F172A"/>
                <textElement verticalAlignment="Top"><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{fournisseurNom}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="392" y="141" width="150" height="16" forecolor="#475569"/>
                <textElement verticalAlignment="Top"><font fontName="DejaVu Sans" size="7.5"/></textElement>
                <textFieldExpression><![CDATA[$P{fournisseurAdresse} != null ? $P{fournisseurAdresse} : "-"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="392" y="157" width="150" height="11" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{fournisseurIce} != null && !$P{fournisseurIce}.trim().isEmpty() ? "ICE : " + $P{fournisseurIce} : ""]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- Tableau : DÉSIGNATION, QTÉ, P.U. HT, TVA, P.U. TTC, TOTAL -->
    <columnHeader>
        <band height="28">
            <rectangle>
                <reportElement x="0" y="2" width="555" height="25" backcolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <line>
                <reportElement x="0" y="27" width="555" height="1" forecolor="#0F172A"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="6" y="2" width="230" height="25" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[DÉSIGNATION]]></text>
            </staticText>
            <staticText>
                <reportElement x="240" y="2" width="55" height="25" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[QTÉ]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="2" width="60" height="25" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[P.U. HT]]></text>
            </staticText>
            <staticText>
                <reportElement x="365" y="2" width="45" height="25" forecolor="#0F172A"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[TVA]]></text>
            </staticText>
            <staticText>
                <reportElement x="415" y="2" width="60" height="25" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[P.U. TTC]]></text>
            </staticText>
            <staticText>
                <reportElement x="480" y="2" width="71" height="25" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Détail des articles -->
    <detail>
        <band height="20">
            <rectangle>
                <reportElement style="zebra" stretchType="RelativeToBandHeight" x="0" y="0" width="555" height="20"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <line>
                <reportElement positionType="FixRelativeToBottom" x="0" y="19" width="555" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <!-- 1. DÉSIGNATION -->
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToBandHeight" x="6" y="0" width="230" height="20" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[($F{reference} != null && !$F{reference}.trim().isEmpty() ? "[" + $F{reference} + "] " : "") + ($F{designation} != null ? $F{designation} : "")]]></textFieldExpression>
            </textField>
            <!-- 2. QTÉ -->
            <textField pattern="#,##0.##" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToBandHeight" x="240" y="0" width="55" height="20" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{quantite} != null ? $F{quantite} : java.math.BigDecimal.ZERO]]></textFieldExpression>
            </textField>
            <!-- 3. P.U. HT -->
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToBandHeight" x="300" y="0" width="60" height="20" forecolor="#475569"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{prixUnitaireHT} != null ? $F{prixUnitaireHT} : ($F{prixUnitaire} != null ? $F{prixUnitaire} : java.math.BigDecimal.ZERO)]]></textFieldExpression>
            </textField>
            <!-- 4. TVA -->
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToBandHeight" x="365" y="0" width="45" height="20" forecolor="#475569"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{tauxTVA} != null ? String.valueOf($F{tauxTVA}.setScale(0, java.math.RoundingMode.HALF_UP)) + " %" : "20 %"]]></textFieldExpression>
            </textField>
            <!-- 5. P.U. TTC -->
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToBandHeight" x="415" y="0" width="60" height="20" forecolor="#475569"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[($F{prixUnitaireHT} != null ? $F{prixUnitaireHT} : ($F{prixUnitaire} != null ? $F{prixUnitaire} : java.math.BigDecimal.ZERO)).multiply(java.math.BigDecimal.ONE.add(($F{tauxTVA} != null ? $F{tauxTVA} : new java.math.BigDecimal("20.00")).divide(new java.math.BigDecimal("100.00"), 4, java.math.RoundingMode.HALF_UP)))]]></textFieldExpression>
            </textField>
            <!-- 6. TOTAL -->
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToBandHeight" x="480" y="0" width="71" height="20" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{montantTTC} != null ? $F{montantTTC} : ($F{montantTotal} != null ? $F{montantTotal} : ($F{montantHT} != null ? $F{montantHT} : ($F{prixUnitaire} != null ? $F{prixUnitaire} : java.math.BigDecimal.ZERO).multiply($F{quantite} != null ? $F{quantite} : java.math.BigDecimal.ZERO)))]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Pied de page intermédiaire -->
    <pageFooter>
        <band height="76">
            <line>
                <reportElement x="0" y="0" width="555" height="1" forecolor="#4338CA"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="6" width="450" height="12" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[($P{nomEntreprise} != null ? $P{nomEntreprise}.toUpperCase() : "") +
($P{formeJuridique} != null && !$P{formeJuridique}.trim().isEmpty() ? " - " + $P{formeJuridique} : "") +
($P{capitalSocial} != null && !$P{capitalSocial}.trim().isEmpty() ? " au capital de " + $P{capitalSocial} : "")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="455" y="6" width="65" height="12" forecolor="#475569"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " / "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="520" y="6" width="35" height="12" forecolor="#475569"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="19" width="555" height="11" forecolor="#334155"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5"/></textElement>
                <textFieldExpression><![CDATA["Siège Social : " + ($P{adresseEntreprise} != null ? $P{adresseEntreprise} : "")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="30" width="555" height="11" forecolor="#334155"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5"/></textElement>
                <textFieldExpression><![CDATA["RC : " + ($P{rcEntreprise} != null && !$P{rcEntreprise}.isEmpty() ? $P{rcEntreprise} : "-") + ($P{tribunalRc} != null && !$P{tribunalRc}.trim().isEmpty() ? " (" + $P{tribunalRc} + ")" : "") +
"  |  IF : " + ($P{nifEntreprise} != null && !$P{nifEntreprise}.isEmpty() ? $P{nifEntreprise} : "-") +
"  |  PATENTE : " + ($P{patenteEntreprise} != null && !$P{patenteEntreprise}.isEmpty() ? $P{patenteEntreprise} : "-") +
"  |  ICE : " + ($P{iceEntreprise} != null && !$P{iceEntreprise}.isEmpty() ? $P{iceEntreprise} : "-") +
"  |  CNSS : " + ($P{cnssEntreprise} != null && !$P{cnssEntreprise}.isEmpty() ? $P{cnssEntreprise} : "-")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="41" width="555" height="11" forecolor="#334155"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5"/></textElement>
                <textFieldExpression><![CDATA["Tél : " + ($P{telephoneEntreprise} != null && !$P{telephoneEntreprise}.isEmpty() ? $P{telephoneEntreprise} : "-") +
($P{gsmEntreprise} != null && !$P{gsmEntreprise}.trim().isEmpty() ? "  |  GSM : " + $P{gsmEntreprise} : "") +
($P{emailEntreprise} != null && !$P{emailEntreprise}.trim().isEmpty() ? "  |  Email : " + $P{emailEntreprise} : "")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="52" width="555" height="11" forecolor="#334155"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5"/></textElement>
                <textFieldExpression><![CDATA[($P{banqueEntreprise} != null && !$P{banqueEntreprise}.trim().isEmpty() ? "Banque : " + $P{banqueEntreprise} : "") +
($P{ribEntreprise} != null && !$P{ribEntreprise}.trim().isEmpty() ? "  |  RIB : " + $P{ribEntreprise} : "")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="63" width="555" height="11" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{piedPage} != null ? $P{piedPage} : ""]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Dernière page : TOTAUX FIXES & SIGNATURES -->
    <lastPageFooter>
        <band height="312">
            <!-- Synthèse totaux -->
            <rectangle radius="6">
                <reportElement x="0" y="0" width="555" height="44" backcolor="#F1F5F9"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#94A3B8"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="6" width="45" height="10" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5" isBold="true"/></textElement>
                <text><![CDATA[LIGNES]]></text>
            </staticText>
            <textField>
                <reportElement x="10" y="19" width="45" height="18" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[String.valueOf($V{REPORT_COUNT})]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="65" y="6" width="70" height="10" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5" isBold="true"/></textElement>
                <text><![CDATA[QTÉ TOTALE]]></text>
            </staticText>
            <textField pattern="#,##0.##" isBlankWhenNull="true">
                <reportElement x="65" y="19" width="70" height="18" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{totalQteAchat}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="145" y="6" width="90" height="10" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5" isBold="true"/></textElement>
                <text><![CDATA[TOTAL HT]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="145" y="19" width="90" height="18" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{montantHT} != null ? $P{montantHT} : java.math.BigDecimal.ZERO]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="245" y="6" width="80" height="10" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5" isBold="true"/></textElement>
                <text><![CDATA[TVA]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="245" y="19" width="80" height="18" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{montantTVA} != null ? $P{montantTVA} : java.math.BigDecimal.ZERO]]></textFieldExpression>
            </textField>

            <rectangle radius="4">
                <reportElement x="335" y="4" width="212" height="36" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="1.5" lineColor="#0F172A"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement x="340" y="7" width="202" height="10" forecolor="#475569"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["TOTAL TTC (" + ($P{devise} != null ? $P{devise} : "MAD") + ")"]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="340" y="19" width="202" height="18" forecolor="#0F172A"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{montantTTC} != null ? $P{montantTTC} : java.math.BigDecimal.ZERO]]></textFieldExpression>
            </textField>

            <!-- Montant en lettres & Observations -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="48" width="555" height="22" forecolor="#0F172A"/>
                <textElement verticalAlignment="Top"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{montantEnLettres} != null ? "Arrêtée la présente facture fournisseur à la somme de : " + $P{montantEnLettres}.toUpperCase() : ($P{observations} != null ? "Observations : " + $P{observations} : "")]]></textFieldExpression>
            </textField>

            <!-- Cadres signatures (Gauche : Fournisseur, Droite : Entreprise Acheteuse) -->
            <rectangle radius="6">
                <reportElement x="0" y="76" width="275" height="150" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="1.0" lineColor="#94A3B8"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="82" width="255" height="16" forecolor="#4338CA"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8.5" isBold="true"/></textElement>
                <text><![CDATA[FOURNISSEUR (ÉMETTEUR)]]></text>
            </staticText>
            <line>
                <reportElement x="10" y="100" width="255" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="10" y="105" width="255" height="13" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <text><![CDATA[Cachet et signature du fournisseur :]]></text>
            </staticText>
            <rectangle radius="4">
                <reportElement x="10" y="125" width="255" height="93" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.75" lineStyle="Dashed" lineColor="#475569"/></graphicElement>
            </rectangle>

            <rectangle radius="6">
                <reportElement x="283" y="76" width="272" height="150" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="1.0" lineColor="#94A3B8"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="293" y="82" width="252" height="16" forecolor="#4338CA"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8.5" isBold="true"/></textElement>
                <text><![CDATA[VISA & CONTRÔLE COMPTABILITÉ]]></text>
            </staticText>
            <line>
                <reportElement x="293" y="100" width="252" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="293" y="105" width="252" height="13" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <text><![CDATA[Direction Financière / Comptabilité :]]></text>
            </staticText>
            <rectangle radius="4">
                <reportElement x="293" y="125" width="252" height="93" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.75" lineStyle="Dashed" lineColor="#475569"/></graphicElement>
            </rectangle>

            <!-- Bas de page légal -->
            <line>
                <reportElement x="0" y="234" width="555" height="1" forecolor="#4338CA"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="240" width="450" height="12" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[($P{nomEntreprise} != null ? $P{nomEntreprise}.toUpperCase() : "") +
($P{formeJuridique} != null && !$P{formeJuridique}.trim().isEmpty() ? " - " + $P{formeJuridique} : "") +
($P{capitalSocial} != null && !$P{capitalSocial}.trim().isEmpty() ? " au capital de " + $P{capitalSocial} : "")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="455" y="240" width="65" height="12" forecolor="#475569"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " / "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="520" y="240" width="35" height="12" forecolor="#475569"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="253" width="555" height="11" forecolor="#334155"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5"/></textElement>
                <textFieldExpression><![CDATA["Siège Social : " + ($P{adresseEntreprise} != null ? $P{adresseEntreprise} : "")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="264" width="555" height="11" forecolor="#334155"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5"/></textElement>
                <textFieldExpression><![CDATA["RC : " + ($P{rcEntreprise} != null && !$P{rcEntreprise}.isEmpty() ? $P{rcEntreprise} : "-") + ($P{tribunalRc} != null && !$P{tribunalRc}.trim().isEmpty() ? " (" + $P{tribunalRc} + ")" : "") +
"  |  IF : " + ($P{nifEntreprise} != null && !$P{nifEntreprise}.isEmpty() ? $P{nifEntreprise} : "-") +
"  |  PATENTE : " + ($P{patenteEntreprise} != null && !$P{patenteEntreprise}.isEmpty() ? $P{patenteEntreprise} : "-") +
"  |  ICE : " + ($P{iceEntreprise} != null && !$P{iceEntreprise}.isEmpty() ? $P{iceEntreprise} : "-") +
"  |  CNSS : " + ($P{cnssEntreprise} != null && !$P{cnssEntreprise}.isEmpty() ? $P{cnssEntreprise} : "-")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="275" width="555" height="11" forecolor="#334155"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5"/></textElement>
                <textFieldExpression><![CDATA["Tél : " + ($P{telephoneEntreprise} != null && !$P{telephoneEntreprise}.isEmpty() ? $P{telephoneEntreprise} : "-") +
($P{gsmEntreprise} != null && !$P{gsmEntreprise}.trim().isEmpty() ? "  |  GSM : " + $P{gsmEntreprise} : "") +
($P{emailEntreprise} != null && !$P{emailEntreprise}.trim().isEmpty() ? "  |  Email : " + $P{emailEntreprise} : "")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="286" width="555" height="11" forecolor="#334155"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5"/></textElement>
                <textFieldExpression><![CDATA[($P{banqueEntreprise} != null && !$P{banqueEntreprise}.trim().isEmpty() ? "Banque : " + $P{banqueEntreprise} : "") +
($P{ribEntreprise} != null && !$P{ribEntreprise}.trim().isEmpty() ? "  |  RIB : " + $P{ribEntreprise} : "")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="297" width="555" height="11" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{piedPage} != null ? $P{piedPage} : ""]]></textFieldExpression>
            </textField>
        </band>
    </lastPageFooter>
</jasperReport>
