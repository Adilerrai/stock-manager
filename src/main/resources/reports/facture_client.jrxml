<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="facture_client" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- Paramètres Entreprise / Tenant -->
    <parameter name="logoImage" class="java.awt.Image"/>
    <parameter name="nomEntreprise" class="java.lang.String"/>
    <parameter name="activiteEntreprise" class="java.lang.String"/>
    <parameter name="adresseEntreprise" class="java.lang.String"/>
    <parameter name="telephoneEntreprise" class="java.lang.String"/>
    <parameter name="telephoneSecondaire" class="java.lang.String"/>
    <parameter name="gsmEntreprise" class="java.lang.String"/>
    <parameter name="emailEntreprise" class="java.lang.String"/>
    <parameter name="rcEntreprise" class="java.lang.String"/>
    <parameter name="nifEntreprise" class="java.lang.String"/>
    <parameter name="nisEntreprise" class="java.lang.String"/>
    <parameter name="iceEntreprise" class="java.lang.String"/>
    <parameter name="aiEntreprise" class="java.lang.String"/>
    <parameter name="patenteEntreprise" class="java.lang.String"/>
    <parameter name="cnssEntreprise" class="java.lang.String"/>
    <parameter name="ribEntreprise" class="java.lang.String"/>
    <parameter name="banqueEntreprise" class="java.lang.String"/>
    <parameter name="piedPage" class="java.lang.String"/>
    <parameter name="devise" class="java.lang.String"/>

    <!-- Paramètres Facture -->
    <parameter name="numeroFacture" class="java.lang.String"/>
    <parameter name="dateFacture" class="java.lang.String"/>
    <parameter name="dateEcheance" class="java.lang.String"/>
    <parameter name="statut" class="java.lang.String"/>
    <parameter name="modePaiement" class="java.lang.String"/>
    <parameter name="emiseParNom" class="java.lang.String"/>
    <parameter name="bonLivraisonNumeros" class="java.lang.String"/>
    <parameter name="notes" class="java.lang.String"/>

    <!-- Paramètres Client -->
    <parameter name="clientNom" class="java.lang.String"/>
    <parameter name="clientTelephone" class="java.lang.String"/>
    <parameter name="clientAdresse" class="java.lang.String"/>
    <parameter name="clientNif" class="java.lang.String"/>
    <parameter name="clientRc" class="java.lang.String"/>
    <parameter name="clientIce" class="java.lang.String"/>

    <!-- Totaux Facture -->
    <parameter name="montantHT" class="java.math.BigDecimal"/>
    <parameter name="montantTVA" class="java.math.BigDecimal"/>
    <parameter name="montantTTC" class="java.math.BigDecimal"/>
    <parameter name="remiseGlobale" class="java.math.BigDecimal"/>
    <parameter name="montantFinal" class="java.math.BigDecimal"/>
    <parameter name="montantPaye" class="java.math.BigDecimal"/>
    <parameter name="montantRestant" class="java.math.BigDecimal"/>

    <!-- Champs des lignes de facture -->
    <field name="reference" class="java.lang.String"/>
    <field name="designation" class="java.lang.String"/>
    <field name="quantite" class="java.math.BigDecimal"/>
    <field name="prixUnitaireHT" class="java.math.BigDecimal"/>
    <field name="tauxTVA" class="java.math.BigDecimal"/>
    <field name="montantHT" class="java.math.BigDecimal"/>
    <field name="montantTTC" class="java.math.BigDecimal"/>

    <!-- Group Header avec le même bleu ciel uni pour les colonnes, répété sur chaque page -->
    <group name="ArticlesGroup" isReprintHeaderOnEachPage="true" minHeightToStartNewPage="40">
        <groupHeader>
            <band height="24">
                <rectangle radius="5">
                    <reportElement x="0" y="0" width="555" height="24" backcolor="#0284C7"/>
                    <graphicElement><pen lineWidth="0"/></graphicElement>
                </rectangle>
                <staticText>
                    <reportElement x="8" y="0" width="75" height="24" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                    <text><![CDATA[RÉFÉRENCE]]></text>
                </staticText>
                <staticText>
                    <reportElement x="88" y="0" width="222" height="24" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                    <text><![CDATA[DÉSIGNATION ARTICLE]]></text>
                </staticText>
                <staticText>
                    <reportElement x="315" y="0" width="45" height="24" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                    <text><![CDATA[QTÉ]]></text>
                </staticText>
                <staticText>
                    <reportElement x="365" y="0" width="55" height="24" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                    <text><![CDATA[P.U. HT]]></text>
                </staticText>
                <staticText>
                    <reportElement x="425" y="0" width="45" height="24" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                    <text><![CDATA[TVA]]></text>
                </staticText>
                <staticText>
                    <reportElement x="475" y="0" width="72" height="24" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                    <text><![CDATA[TOTAL HT]]></text>
                </staticText>
            </band>
        </groupHeader>
    </group>

    <!-- En-tête professionnel affiché sur TOUTES les pages -->
    <pageHeader>
        <band height="144">
            <!-- Logo ou Nom Entreprise -->
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="0" y="0" width="115" height="48"/>
                <imageExpression><![CDATA[$P{logoImage}]]></imageExpression>
            </image>

            <textField isBlankWhenNull="true">
                <reportElement x="125" y="6" width="235" height="22" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{nomEntreprise}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="125" y="28" width="235" height="14" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{activiteEntreprise}]]></textFieldExpression>
            </textField>

            <!-- Badge Document (Bleu ciel unifié avec coins arrondis) -->
            <rectangle radius="6">
                <reportElement x="370" y="0" width="185" height="52" backcolor="#0284C7"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="375" y="4" width="175" height="15" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[FACTURE]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="375" y="19" width="175" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{numeroFacture}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="375" y="35" width="175" height="13" forecolor="#E0F2FE"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA["Date: " + $P{dateFacture}]]></textFieldExpression>
            </textField>

            <!-- Ligne de séparation fine en bleu ciel -->
            <line>
                <reportElement x="0" y="58" width="555" height="1" forecolor="#BAE6FD"/>
                <graphicElement><pen lineWidth="0.75"/></graphicElement>
            </line>

            <!-- Carte Informations Facture (Gauche) -->
            <rectangle radius="6">
                <reportElement x="0" y="66" width="268" height="66" backcolor="#F8FAFC"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#0284C7"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="12" y="71" width="150" height="14" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[DÉTAILS FACTURE]]></text>
            </staticText>
            <staticText>
                <reportElement x="12" y="87" width="70" height="13" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[Échéance :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="82" y="87" width="178" height="13" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{dateEcheance} != null ? $P{dateEcheance} : "À réception"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="12" y="101" width="70" height="13" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[Règlement :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="82" y="101" width="178" height="13" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{modePaiement} != null ? $P{modePaiement} : "Virement / Chèque"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="12" y="115" width="70" height="13" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[N° BL :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="82" y="115" width="178" height="13" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{bonLivraisonNumeros} != null && !$P{bonLivraisonNumeros}.isEmpty() ? $P{bonLivraisonNumeros} : "-"]]></textFieldExpression>
            </textField>

            <!-- Carte Client (Droite) -->
            <rectangle radius="6">
                <reportElement x="287" y="66" width="268" height="66" backcolor="#F8FAFC"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#0284C7"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="299" y="71" width="100" height="14" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[CLIENT :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="299" y="87" width="245" height="14" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{clientNom}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="299" y="102" width="245" height="13" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{clientAdresse} != null ? $P{clientAdresse} : ""]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="299" y="115" width="245" height="13" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[($P{clientIce} != null && !$P{clientIce}.trim().isEmpty() ? "ICE : " + $P{clientIce} : "") + ($P{clientTelephone} != null && !$P{clientTelephone}.trim().isEmpty() && !$P{clientTelephone}.equals("-") ? ($P{clientIce} != null && !$P{clientIce}.trim().isEmpty() ? "   -   " : "") + "Tél : " + $P{clientTelephone} : "")]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- Détails des articles -->
    <detail>
        <band height="16">
            <line>
                <reportElement x="0" y="15" width="555" height="1" forecolor="#E0F2FE"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="8" y="0" width="75" height="15" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{reference}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="88" y="0" width="222" height="15" forecolor="#1E293B"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{designation}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="315" y="0" width="45" height="15" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{quantite}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="365" y="0" width="55" height="15" forecolor="#475569"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{prixUnitaireHT}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.0" isBlankWhenNull="true">
                <reportElement x="425" y="0" width="45" height="15" forecolor="#475569"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[($F{tauxTVA} != null ? $F{tauxTVA} : java.math.BigDecimal.ZERO) + "%"]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="475" y="0" width="72" height="15" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{montantHT}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Pied de page pour pages intermédiaires -->
    <pageFooter>
        <band height="62">
            <line>
                <reportElement x="0" y="2" width="555" height="1" forecolor="#0284C7"/>
                <graphicElement><pen lineWidth="1"/></graphicElement>
            </line>
            <textField>
                <reportElement x="455" y="4" width="65" height="12" forecolor="#64748B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " / "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="520" y="4" width="35" height="12" forecolor="#64748B"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="16" width="555" height="12" forecolor="#0284C7"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["société " + ($P{nomEntreprise} != null ? $P{nomEntreprise} : "")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="27" width="555" height="11" forecolor="#334155"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Siège Social : " + ($P{adresseEntreprise} != null ? $P{adresseEntreprise} : "")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="38" width="555" height="11" forecolor="#334155"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["RC : " + ($P{rcEntreprise} != null && !$P{rcEntreprise}.isEmpty() ? $P{rcEntreprise} : "-") +
"  -  IF : " + ($P{nifEntreprise} != null && !$P{nifEntreprise}.isEmpty() ? $P{nifEntreprise} : "-") +
"  -  PATENTE : " + ($P{patenteEntreprise} != null && !$P{patenteEntreprise}.equals("-") ? $P{patenteEntreprise} : ($P{aiEntreprise} != null ? $P{aiEntreprise} : "-")) +
"  -  ICE : " + ($P{iceEntreprise} != null && !$P{iceEntreprise}.equals("-") ? $P{iceEntreprise} : ($P{nisEntreprise} != null ? $P{nisEntreprise} : "-")) +
"  -  CNSS : " + ($P{cnssEntreprise} != null && !$P{cnssEntreprise}.equals("-") ? $P{cnssEntreprise} : "-")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="49" width="555" height="11" forecolor="#0284C7"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["FIX : " + ($P{telephoneEntreprise} != null && !$P{telephoneEntreprise}.isEmpty() ? $P{telephoneEntreprise} : "-") +
($P{gsmEntreprise} != null && !$P{gsmEntreprise}.trim().isEmpty() ? "   GSM : " + $P{gsmEntreprise} : ($P{telephoneSecondaire} != null && !$P{telephoneSecondaire}.trim().isEmpty() ? "   GSM : " + $P{telephoneSecondaire} : "")) +
($P{emailEntreprise} != null && !$P{emailEntreprise}.trim().isEmpty() ? "  -  EMAIL : " + $P{emailEntreprise} : "")]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Dernière page : LA SYNTHÈSE EST EN BAS (ancrée en bas de page avec modalités de paiement et totaux) -->
    <lastPageFooter>
        <band height="180">
            <!-- Bloc Coordonnées Bancaires & Notes (Gauche) -->
            <rectangle radius="6">
                <reportElement x="0" y="4" width="268" height="98" backcolor="#F8FAFC"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#BAE6FD"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="10" width="160" height="14" forecolor="#0284C7"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[MODALITÉS DE PAIEMENT]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="10" y="26" width="250" height="13" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{banqueEntreprise} != null && !$P{banqueEntreprise}.trim().isEmpty() ? "Banque : " + $P{banqueEntreprise} : ""]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="10" y="40" width="250" height="13" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{ribEntreprise} != null && !$P{ribEntreprise}.trim().isEmpty() ? "RIB : " + $P{ribEntreprise} : ""]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="10" y="56" width="250" height="40" forecolor="#64748B"/>
                <textElement><font fontName="SansSerif" size="7" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{notes} != null && !$P{notes}.trim().isEmpty() ? "Notes : " + $P{notes} : ""]]></textFieldExpression>
            </textField>

            <!-- Carte Totaux Facture (Droite) -->
            <rectangle radius="6">
                <reportElement x="287" y="4" width="268" height="98" backcolor="#F8FAFC"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#0284C7"/></graphicElement>
            </rectangle>

            <!-- Total HT -->
            <staticText>
                <reportElement x="297" y="9" width="95" height="13" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[Total Hors Taxe :]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="395" y="9" width="150" height="13" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[($P{montantHT} != null ? $P{montantHT} : java.math.BigDecimal.ZERO) + " " + $P{devise}]]></textFieldExpression>
            </textField>

            <!-- TVA -->
            <staticText>
                <reportElement x="297" y="23" width="95" height="13" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[Montant TVA :]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="395" y="23" width="150" height="13" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[($P{montantTVA} != null ? $P{montantTVA} : java.math.BigDecimal.ZERO) + " " + $P{devise}]]></textFieldExpression>
            </textField>

            <!-- Remise si renseignée -->
            <staticText>
                <reportElement x="297" y="37" width="95" height="13" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[Remise :]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="395" y="37" width="150" height="13" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[($P{remiseGlobale} != null ? $P{remiseGlobale} : java.math.BigDecimal.ZERO) + " " + $P{devise}]]></textFieldExpression>
            </textField>

            <!-- Bannière NET À PAYER (Bleu ciel unifié et coins arrondis) -->
            <rectangle radius="5">
                <reportElement x="293" y="53" width="256" height="26" backcolor="#0284C7"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="301" y="56" width="95" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[NET À PAYER :]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="400" y="56" width="143" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[($P{montantFinal} != null ? $P{montantFinal} : ($P{montantTTC} != null ? $P{montantTTC} : $P{montantHT})) + " " + $P{devise}]]></textFieldExpression>
            </textField>

            <!-- Reste à régler -->
            <staticText>
                <reportElement x="297" y="82" width="95" height="13" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[Reste à régler :]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="395" y="82" width="150" height="13" forecolor="#0284C7"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[($P{montantRestant} != null ? $P{montantRestant} : ($P{montantFinal} != null ? $P{montantFinal} : $P{montantHT})) + " " + $P{devise}]]></textFieldExpression>
            </textField>

            <!-- Ligne de séparation Footer -->
            <line>
                <reportElement x="0" y="110" width="555" height="1" forecolor="#0284C7"/>
                <graphicElement><pen lineWidth="1"/></graphicElement>
            </line>

            <textField>
                <reportElement x="455" y="112" width="65" height="12" forecolor="#64748B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " / "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="520" y="112" width="35" height="12" forecolor="#64748B"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="124" width="555" height="12" forecolor="#0284C7"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["société " + ($P{nomEntreprise} != null ? $P{nomEntreprise} : "")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="135" width="555" height="11" forecolor="#334155"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Siège Social : " + ($P{adresseEntreprise} != null ? $P{adresseEntreprise} : "")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="146" width="555" height="11" forecolor="#334155"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["RC : " + ($P{rcEntreprise} != null && !$P{rcEntreprise}.isEmpty() ? $P{rcEntreprise} : "-") +
"  -  IF : " + ($P{nifEntreprise} != null && !$P{nifEntreprise}.isEmpty() ? $P{nifEntreprise} : "-") +
"  -  PATENTE : " + ($P{patenteEntreprise} != null && !$P{patenteEntreprise}.equals("-") ? $P{patenteEntreprise} : ($P{aiEntreprise} != null ? $P{aiEntreprise} : "-")) +
"  -  ICE : " + ($P{iceEntreprise} != null && !$P{iceEntreprise}.equals("-") ? $P{iceEntreprise} : ($P{nisEntreprise} != null ? $P{nisEntreprise} : "-")) +
"  -  CNSS : " + ($P{cnssEntreprise} != null && !$P{cnssEntreprise}.equals("-") ? $P{cnssEntreprise} : "-")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="157" width="555" height="11" forecolor="#0284C7"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["FIX : " + ($P{telephoneEntreprise} != null && !$P{telephoneEntreprise}.isEmpty() ? $P{telephoneEntreprise} : "-") +
($P{gsmEntreprise} != null && !$P{gsmEntreprise}.trim().isEmpty() ? "   GSM : " + $P{gsmEntreprise} : ($P{telephoneSecondaire} != null && !$P{telephoneSecondaire}.trim().isEmpty() ? "   GSM : " + $P{telephoneSecondaire} : "")) +
($P{emailEntreprise} != null && !$P{emailEntreprise}.trim().isEmpty() ? "  -  EMAIL : " + $P{emailEntreprise} : "")]]></textFieldExpression>
            </textField>
        </band>
    </lastPageFooter>

</jasperReport>
