				<textFieldExpression><![CDATA[($P{montantFinal} != null ? $P{montantFinal} : ($P{montantTTC} != null ? $P{montantTTC} : java.math.BigDecimal.ZERO)) + " " + ($P{devise} != null ? $P{devise} : "MAD")]]></textFieldExpression>
			</textField>

			<!-- Mention Montant en lettres -->
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="28" y="74" width="539" height="16" forecolor="#475569" uuid="f98e1234-0039-4000-8000-000000000039"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5" isItalic="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{montantEnLettres} != null && !$P{montantEnLettres}.isEmpty() ? "Arrêtée la présente facture à la somme de : " + $P{montantEnLettres} : ""]]></textFieldExpression>
			</textField>

			<!-- Ligne de séparation et pied légal -->
			<line>
				<reportElement x="28" y="98" width="539" height="1" forecolor="#1F2937" uuid="f98e1234-0040-4000-8000-000000000040"/>
				<graphicElement>
					<pen lineWidth="0.8"/>
				</graphicElement>
			</line>
			<textField isBlankWhenNull="true">
				<reportElement x="28" y="103" width="539" height="24" forecolor="#1F2937" uuid="f98e1234-0041-4000-8000-000000000041"/>
				<textElement textAlignment="Center" verticalAlignment="Top" markup="html">
					<font fontName="DejaVu Sans" size="7.5"/>
				</textElement>
				<textFieldExpression><![CDATA["<b>IF</b>: " + ($P{nifEntreprise} != null ? $P{nifEntreprise} : "-") + " - <b>Patente</b>: " + ($P{patenteEntreprise} != null ? $P{patenteEntreprise} : "-") + " - <b>CNSS</b>: " + ($P{cnssEntreprise} != null ? $P{cnssEntreprise} : "-") + " - <b>RC</b>: " + ($P{rcEntreprise} != null ? $P{rcEntreprise} : "-") + " - <b>ICE</b>: " + ($P{iceEntreprise} != null ? $P{iceEntreprise} : "-") + " <b>Email</b>: " + ($P{emailEntreprise} != null ? $P{emailEntreprise} : "-") + " <b>Tél</b>: " + ($P{telephoneEntreprise} != null ? $P{telephoneEntreprise} : "-")]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="447" y="127" width="60" height="11" forecolor="#6B7280" uuid="f98e1234-0042-4000-8000-000000000042"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " /"]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement x="509" y="127" width="58" height="11" forecolor="#6B7280" uuid="f98e1234-0043-4000-8000-000000000043"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</lastPageFooter>
</jasperReport>
