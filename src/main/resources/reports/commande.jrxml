<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports 
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="commande_template" pageWidth="595" pageHeight="842" 
              columnWidth="555" leftMargin="20" rightMargin="20" 
              topMargin="20" bottomMargin="20">

    <parameter name="numeroCommande" class="java.lang.String"/>
    <parameter name="dateCommande" class="java.time.LocalDateTime"/>
    <parameter name="dateLivraisonPrevue" class="java.time.LocalDateTime"/>
    <parameter name="fournisseurNom" class="java.lang.String"/>
    <parameter name="fournisseurAdresse" class="java.lang.String"/>
    <parameter name="montantTotal" class="java.math.BigDecimal"/>
    <parameter name="observations" class="java.lang.String"/>
    <parameter name="statut" class="java.lang.String"/>
    <parameter name="lignesCommande" class="net.sf.jasperreports.engine.JRDataSource"/>
    <parameter name="SUBREPORT_DIR" class="net.sf.jasperreports.engine.JasperReport"/>

    <title>
        <band height="120">
            <!-- Header avec fond coloré #2C3D52 et coins arrondis radius 8 -->
            <rectangle radius="8">
                <reportElement x="0" y="0" width="555" height="80" backcolor="#2C3D52"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            
            <!-- Titre principal -->
            <staticText>
                <reportElement x="20" y="15" width="300" height="25" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[BON DE COMMANDE ACHAT]]></text>
            </staticText>
            
            <!-- Logo ou nom entreprise -->
            <staticText>
                <reportElement x="20" y="45" width="200" height="20" forecolor="#CBD5E1"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11"/>
                </textElement>
                <text><![CDATA[GESTION DES ACHATS]]></text>
            </staticText>
            
            <!-- Numéro de commande avec conteneur radius 8 -->
            <rectangle radius="8">
                <reportElement x="375" y="10" width="165" height="30" backcolor="#FFFFFF"/>
                <graphicElement>
                    <pen lineWidth="0.75" lineColor="#E2E8F0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="382" y="15" width="70" height="20" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[N° Commande:]]></text>
            </staticText>
            <textField>
                <reportElement x="455" y="15" width="80" height="20" forecolor="#2C3D52"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" />
                </textElement>
                <textFieldExpression><![CDATA[$P{numeroCommande}]]></textFieldExpression>
            </textField>
            
            <!-- Date avec conteneur radius 8 -->
            <rectangle radius="8">
                <reportElement x="375" y="44" width="165" height="26" backcolor="#FFFFFF"/>
                <graphicElement>
                    <pen lineWidth="0.75" lineColor="#E2E8F0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="382" y="49" width="45" height="16" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Date:]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="430" y="49" width="105" height="16" forecolor="#1E293B"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateCommande}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <pageHeader>
        <band height="120">
            <!-- Section Fournisseur avec conteneur radius 8 -->
            <rectangle radius="8">
                <reportElement x="0" y="10" width="270" height="100" backcolor="#FFFFFF"/>
                <graphicElement>
                    <pen lineWidth="0.75" lineColor="#E2E8F0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement mode="Opaque" x="10" y="18" width="110" height="18" forecolor="#1E293B" backcolor="#F1F5F9"/>
                <box>
                    <topPen lineWidth="0.5" lineColor="#CBD5E1"/>
                    <leftPen lineWidth="0.5" lineColor="#CBD5E1"/>
                    <bottomPen lineWidth="0.5" lineColor="#CBD5E1"/>
                    <rightPen lineWidth="0.5" lineColor="#CBD5E1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[FOURNISSEUR]]></text>
            </staticText>
            <textField>
                <reportElement x="10" y="45" width="250" height="20" forecolor="#1E293B"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{fournisseurNom}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="10" y="68" width="250" height="32" forecolor="#475569"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{fournisseurAdresse}]]></textFieldExpression>
            </textField>
            
            <!-- Section Livraison avec conteneur radius 8 -->
            <rectangle radius="8">
                <reportElement x="285" y="10" width="270" height="100" backcolor="#FFFFFF"/>
                <graphicElement>
                    <pen lineWidth="0.75" lineColor="#E2E8F0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement mode="Opaque" x="295" y="18" width="90" height="18" forecolor="#1E293B" backcolor="#F1F5F9"/>
                <box>
                    <topPen lineWidth="0.5" lineColor="#CBD5E1"/>
                    <leftPen lineWidth="0.5" lineColor="#CBD5E1"/>
                    <bottomPen lineWidth="0.5" lineColor="#CBD5E1"/>
                    <rightPen lineWidth="0.5" lineColor="#CBD5E1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[LIVRAISON]]></text>
            </staticText>
            <staticText>
                <reportElement x="295" y="45" width="80" height="15" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Date prévue:]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
                <reportElement x="380" y="45" width="170" height="15" forecolor="#1E293B"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dateLivraisonPrevue}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="295" y="65" width="50" height="15" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Statut:]]></text>
            </staticText>
            <textField>
                <reportElement x="350" y="65" width="200" height="15" forecolor="#2C3D52"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{statut}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="40">
            <!-- En-tête du tableau #2C3D52 avec coins arrondis radius 8 -->
            <rectangle radius="8">
                <reportElement x="0" y="10" width="555" height="25" backcolor="#2C3D52"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="15" width="80" height="15" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[RÉFÉRENCE]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="15" width="200" height="15" forecolor="#FFFFFF"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[DESCRIPTION]]></text>
            </staticText>
            <staticText>
                <reportElement x="310" y="15" width="60" height="15" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[QUANTITÉ]]></text>
            </staticText>
            <staticText>
                <reportElement x="380" y="15" width="80" height="15" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[PRIX UNIT.]]></text>
            </staticText>
            <staticText>
                <reportElement x="470" y="15" width="75" height="15" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[MONTANT]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="200">
            <subreport>
                <reportElement x="0" y="0" width="555" height="200"/>
                <dataSourceExpression><![CDATA[$P{lignesCommande}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{SUBREPORT_DIR}]]></subreportExpression>
            </subreport>
        </band>
    </detail>

    <summary>
        <band height="120">
            <!-- Ligne de séparation fine -->
            <line>
                <reportElement x="0" y="10" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="1" lineColor="#CBD5E1"/>
                </graphicElement>
            </line>
            
            <!-- Section Observations avec conteneur radius 8 -->
            <rectangle radius="8">
                <reportElement x="0" y="18" width="370" height="42" backcolor="#FFFFFF"/>
                <graphicElement>
                    <pen lineWidth="0.75" lineColor="#E2E8F0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="8" y="22" width="80" height="14" forecolor="#2C3D52"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Observations:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="88" y="22" width="272" height="34" forecolor="#475569"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{observations}]]></textFieldExpression>
            </textField>
            
            <!-- Total avec style #2C3D52 et radius 8 -->
            <rectangle radius="8">
                <reportElement x="385" y="18" width="170" height="42" backcolor="#2C3D52"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="395" y="27" width="55" height="24" forecolor="#FFFFFF"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="450" y="27" width="95" height="24" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{montantTotal} + " DH"]]></textFieldExpression>
            </textField>
            
            <!-- Footer -->
            <staticText>
                <reportElement x="0" y="80" width="555" height="15" forecolor="#64748B"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="8" isItalic="true"/>
                </textElement>
                <text><![CDATA[Document généré automatiquement - Point Vente SaaS]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>