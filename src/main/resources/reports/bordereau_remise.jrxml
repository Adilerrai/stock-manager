<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bordereau_remise" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="logoImage" class="java.awt.Image"/>
    <parameter name="nomEntreprise" class="java.lang.String"/>
    <parameter name="activiteEntreprise" class="java.lang.String"/>
    <parameter name="adresseEntreprise" class="java.lang.String"/>
    <parameter name="telephoneEntreprise" class="java.lang.String"/>
    <parameter name="rcEntreprise" class="java.lang.String"/>
    <parameter name="nifEntreprise" class="java.lang.String"/>
    <parameter name="devise" class="java.lang.String"/>

    <parameter name="numeroBordereau" class="java.lang.String"/>
    <parameter name="dateRemise" class="java.lang.String"/>
    <parameter name="nomBanqueDepot" class="java.lang.String"/>
    <parameter name="compteBancaire" class="java.lang.String"/>
    <parameter name="nombreCheques" class="java.lang.Integer"/>
    <parameter name="montantTotal" class="java.math.BigDecimal"/>

    <field name="numeroPiece" class="java.lang.String"/>
    <field name="tireur" class="java.lang.String"/>
    <field name="banqueEmettrice" class="java.lang.String"/>
    <field name="dateEcheance" class="java.lang.String"/>
    <field name="montant" class="java.math.BigDecimal"/>

    <title>
        <band height="150">
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="0" y="0" width="120" height="60"/>
                <imageExpression><![CDATA[$P{logoImage}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="130" y="0" width="250" height="20"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{nomEntreprise}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="130" y="20" width="250" height="14" forecolor="#555555"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{adresseEntreprise} + " - Tél: " + $P{telephoneEntreprise}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="130" y="34" width="250" height="14" forecolor="#555555"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA["RC: " + $P{rcEntreprise} + " | NIF: " + $P{nifEntreprise}]]></textFieldExpression>
            </textField>

            <!-- Titre Encadré Bordereau -->
            <rectangle radius="4">
                <reportElement x="390" y="0" width="165" height="55" backcolor="#F8FAFC"/>
                <graphicElement><pen lineWidth="1.0" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="390" y="5" width="165" height="16" forecolor="#1E293B"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true"/></textElement>
                <text><![CDATA[BORDEREAU DE REMISE]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="390" y="22" width="165" height="14" forecolor="#2563EB"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{numeroBordereau}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="390" y="36" width="165" height="14" forecolor="#64748B"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA["Date : " + $P{dateRemise}]]></textFieldExpression>
            </textField>

            <!-- Cadre Banque Réceptrice -->
            <rectangle radius="4">
                <reportElement x="0" y="80" width="555" height="55" backcolor="#F1F5F9"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="15" y="85" width="120" height="15" forecolor="#475569"/>
                <textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Banque de Dépôt :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="140" y="85" width="200" height="15"/>
                <textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{nomBanqueDepot}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="15" y="105" width="120" height="15" forecolor="#475569"/>
                <textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Compte à créditer (RIB) :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="140" y="105" width="250" height="15" forecolor="#0F172A"/>
                <textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{compteBancaire}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="400" y="85" width="70" height="15" forecolor="#475569"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Nb Valeurs :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="475" y="85" width="65" height="15" forecolor="#2563EB"/>
                <textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{nombreCheques}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <rectangle radius="2">
                <reportElement x="0" y="0" width="555" height="24" backcolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="5" y="4" width="95" height="16"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[N° Chèque/Effet]]></text>
            </staticText>
            <staticText>
                <reportElement x="105" y="4" width="160" height="16"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Tireur / Émetteur]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="4" width="110" height="16"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Banque Émettrice]]></text>
            </staticText>
            <staticText>
                <reportElement x="385" y="4" width="70" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Échéance]]></text>
            </staticText>
            <staticText>
                <reportElement x="460" y="4" width="90" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Montant]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <line>
                <reportElement x="0" y="19" width="555" height="1" forecolor="#F1F5F9"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="5" y="2" width="95" height="16"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{numeroPiece}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="105" y="2" width="160" height="16"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{tireur}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="270" y="2" width="110" height="16"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{banqueEmettrice}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="385" y="2" width="70" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{dateEcheance}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="460" y="2" width="90" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{montant}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer pour les pages intermédiaires -->
    <pageFooter>
        <band height="20">
            <line>
                <reportElement x="0" y="0" width="555" height="1" forecolor="#CCCCCC"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <textField evaluationTime="Report">
                <reportElement x="455" y="3" width="100" height="16" forecolor="#666666"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Last Page Footer : TOUJOURS DOCKÉ EN BAS DE PAGE -->
    <lastPageFooter>
        <band height="120">
            <rectangle radius="3">
                <reportElement x="340" y="5" width="215" height="32" backcolor="#F9FAFB"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D1D5DB"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="350" y="11" width="90" height="18" forecolor="#111827"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[TOTAL REMIS :]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="445" y="11" width="105" height="18" forecolor="#111827"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{montantTotal} + " " + $P{devise}]]></textFieldExpression>
            </textField>

            <!-- Signatures -->
            <staticText>
                <reportElement x="30" y="55" width="180" height="15" forecolor="#4B5563"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Signature &amp; Cachet Déposant]]></text>
            </staticText>
            <staticText>
                <reportElement x="340" y="55" width="180" height="15" forecolor="#4B5563"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Accusé de réception Banque]]></text>
            </staticText>

            <!-- Ligne & Pied de page -->
            <line>
                <reportElement x="0" y="98" width="555" height="1" forecolor="#CCCCCC"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <textField evaluationTime="Report">
                <reportElement x="455" y="101" width="100" height="18" forecolor="#666666"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </lastPageFooter>
</jasperReport>
