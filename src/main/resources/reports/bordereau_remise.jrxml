<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bordereau_remise" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- Paramètres Entreprise -->
    <parameter name="logoImage" class="java.awt.Image"/>
    <parameter name="nomEntreprise" class="java.lang.String"/>
    <parameter name="activiteEntreprise" class="java.lang.String"/>
    <parameter name="adresseEntreprise" class="java.lang.String"/>
    <parameter name="telephoneEntreprise" class="java.lang.String"/>
    <parameter name="rcEntreprise" class="java.lang.String"/>
    <parameter name="nifEntreprise" class="java.lang.String"/>
    <parameter name="iceEntreprise" class="java.lang.String"/>
    <parameter name="devise" class="java.lang.String"/>

    <!-- Paramètres Bordereau -->
    <parameter name="numeroBordereau" class="java.lang.String"/>
    <parameter name="dateRemise" class="java.lang.String"/>
    <parameter name="nomBanqueDepot" class="java.lang.String"/>
    <parameter name="compteBancaire" class="java.lang.String"/>
    <parameter name="nombreCheques" class="java.lang.Integer"/>
    <parameter name="montantTotal" class="java.math.BigDecimal"/>

    <!-- Champs Chèques / Effets -->
    <field name="numeroPiece" class="java.lang.String"/>
    <field name="tireur" class="java.lang.String"/>
    <field name="banqueEmettrice" class="java.lang.String"/>
    <field name="dateEcheance" class="java.lang.String"/>
    <field name="montant" class="java.math.BigDecimal"/>

    <title>
        <band height="145">
            <!-- Logo Entreprise -->
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="0" y="0" width="120" height="55"/>
                <imageExpression><![CDATA[$P{logoImage}]]></imageExpression>
            </image>

            <!-- Infos Entreprise -->
            <textField isBlankWhenNull="true">
                <reportElement x="130" y="0" width="250" height="18" forecolor="#2C3D52"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{nomEntreprise}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="130" y="18" width="250" height="13" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{activiteEntreprise}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="130" y="31" width="250" height="13" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{adresseEntreprise} + " - Tél: " + $P{telephoneEntreprise}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="130" y="44" width="250" height="13" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["RC: " + ($P{rcEntreprise} != null ? $P{rcEntreprise} : "-") + " | ICE: " + ($P{iceEntreprise} != null ? $P{iceEntreprise} : "-")]]></textFieldExpression>
            </textField>

            <!-- Titre Encadré Bordereau (#2C3D52 avec coins arrondis radius 8) -->
            <rectangle radius="8">
                <reportElement x="390" y="0" width="165" height="55" backcolor="#2C3D52"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="390" y="5" width="165" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <text><![CDATA[BORDEREAU DE REMISE]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="390" y="22" width="165" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{numeroBordereau}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="390" y="36" width="165" height="14" forecolor="#CBD5E1"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Date : " + $P{dateRemise}]]></textFieldExpression>
            </textField>

            <!-- Ligne de séparation fine -->
            <line>
                <reportElement x="0" y="68" width="555" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.75"/></graphicElement>
            </line>

            <!-- Cadre Banque Réceptrice (radius 8, border #E2E8F0) -->
            <rectangle radius="8">
                <reportElement x="0" y="78" width="555" height="55" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="15" y="83" width="120" height="15" forecolor="#64748B"/>
                <textElement><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Banque de Dépôt :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="140" y="83" width="240" height="15" forecolor="#1E293B"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{nomBanqueDepot}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="15" y="105" width="120" height="15" forecolor="#64748B"/>
                <textElement><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Compte à créditer (RIB) :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="140" y="105" width="240" height="15" forecolor="#2C3D52"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{compteBancaire}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="390" y="83" width="75" height="15" forecolor="#64748B"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Nb Valeurs :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="470" y="83" width="75" height="15" forecolor="#1E293B"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{nombreCheques}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <rectangle radius="8">
                <reportElement x="0" y="0" width="555" height="24" backcolor="#2C3D52"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="8" y="4" width="95" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[N° Chèque/Effet]]></text>
            </staticText>
            <staticText>
                <reportElement x="105" y="4" width="160" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Tireur / Émetteur]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="4" width="110" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Banque Émettrice]]></text>
            </staticText>
            <staticText>
                <reportElement x="385" y="4" width="70" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Échéance]]></text>
            </staticText>
            <staticText>
                <reportElement x="460" y="4" width="87" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Montant]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <line>
                <reportElement x="0" y="19" width="555" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="8" y="2" width="95" height="16" forecolor="#2C3D52"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{numeroPiece}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="105" y="2" width="160" height="16" forecolor="#1E293B"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{tireur}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="270" y="2" width="110" height="16" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{banqueEmettrice}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="385" y="2" width="70" height="16" forecolor="#475569"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{dateEcheance}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="460" y="2" width="87" height="16" forecolor="#1E293B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{montant}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer pour les pages intermédiaires -->
    <pageFooter>
        <band height="20">
            <line>
                <reportElement x="0" y="0" width="555" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <textField evaluationTime="Report">
                <reportElement x="455" y="3" width="100" height="16" forecolor="#64748B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Last Page Footer : TOUJOURS DOCKÉ EN BAS DE PAGE -->
    <lastPageFooter>
        <band height="120">
            <!-- TOTAL REMIS Banner (#2C3D52 avec coins arrondis radius 8) -->
            <rectangle radius="8">
                <reportElement x="340" y="5" width="215" height="34" backcolor="#2C3D52"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="348" y="12" width="85" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <text><![CDATA[TOTAL REMIS :]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="435" y="12" width="112" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{montantTotal} + " " + $P{devise}]]></textFieldExpression>
            </textField>

            <!-- Signatures -->
            <rectangle radius="8">
                <reportElement x="20" y="50" width="200" height="40" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="20" y="55" width="200" height="15" forecolor="#64748B"/>
                <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Signature &amp; Cachet Déposant]]></text>
            </staticText>

            <rectangle radius="8">
                <reportElement x="330" y="50" width="200" height="40" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="330" y="55" width="200" height="15" forecolor="#64748B"/>
                <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Accusé de réception Banque]]></text>
            </staticText>

            <!-- Ligne & Pied de page -->
            <line>
                <reportElement x="0" y="98" width="555" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <textField evaluationTime="Report">
                <reportElement x="455" y="101" width="100" height="18" forecolor="#64748B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </lastPageFooter>
</jasperReport>
