			<!-- P.U. HT -->
			<textField pattern="#,##0.00##" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="369" y="0" width="82" height="29" forecolor="#374151" uuid="c8eba23b-530b-485c-b2e3-a12e9751f851"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8.5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{prixUnitaireHT} != null ? $F{prixUnitaireHT} : ($F{prixUnitaire} != null ? $F{prixUnitaire} : java.math.BigDecimal.ZERO)]]></textFieldExpression>
			</textField>
			<!-- TOTAL HT -->
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="459" y="0" width="90" height="29" forecolor="#111827" uuid="5d25fe30-3f21-4c72-8175-504f5af548fa"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8.5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{montantHT} != null ? $F{montantHT} : ($F{montantTotal} != null ? $F{montantTotal} : ($F{montantLigne} != null ? $F{montantLigne} : ($F{prixUnitaireHT} != null ? $F{prixUnitaireHT} : ($F{prixUnitaire} != null ? $F{prixUnitaire} : java.math.BigDecimal.ZERO)).multiply($F{quantite} != null ? $F{quantite} : ($F{quantiteCommandee} != null ? $F{quantiteCommandee} : java.math.BigDecimal.ZERO))))]]></textFieldExpression>
