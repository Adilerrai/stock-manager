	<parameter name="piedPage" class="java.lang.String"/>
	<parameter name="devise" class="java.lang.String"/>
	<parameter name="numeroCommande" class="java.lang.String"/>
	<parameter name="dateCommande" class="java.lang.String"/>
	<parameter name="dateLivraisonPrevue" class="java.lang.String"/>
	<parameter name="statut" class="java.lang.String"/>
	<parameter name="fournisseurNom" class="java.lang.String"/>
	<parameter name="fournisseurTelephone" class="java.lang.String"/>
	<parameter name="fournisseurAdresse" class="java.lang.String"/>
	<parameter name="fournisseurIce" class="java.lang.String"/>
	<parameter name="observations" class="java.lang.String"/>
	<parameter name="notes" class="java.lang.String"/>
	<parameter name="montantHT" class="java.math.BigDecimal"/>
	<parameter name="montantTVA" class="java.math.BigDecimal"/>
	<parameter name="montantTTC" class="java.math.BigDecimal"/>
	<parameter name="montantTotal" class="java.math.BigDecimal"/>
	<parameter name="montantEnLettres" class="java.lang.String"/>
	<field name="reference" class="java.lang.String"/>
	<field name="designation" class="java.lang.String"/>
	<field name="quantite" class="java.math.BigDecimal"/>
	<field name="quantiteCommandee" class="java.math.BigDecimal"/>
	<field name="prixUnitaire" class="java.math.BigDecimal"/>
	<field name="prixUnitaireHT" class="java.math.BigDecimal"/>
	<field name="tauxTVA" class="java.math.BigDecimal"/>
	<field name="montantTotal" class="java.math.BigDecimal"/>
	<field name="montantHT" class="java.math.BigDecimal"/>
	<field name="montantTTC" class="java.math.BigDecimal"/>
	<field name="montantLigne" class="java.math.BigDecimal"/>
	<variable name="totalQteCommandee" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{quantite} != null ? $F{quantite} : ($F{quantiteCommandee} != null ? $F{quantiteCommandee} : java.math.BigDecimal.ZERO)]]></variableExpression>
		<initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<pageHeader>
		<!-- ============================================================ -->
		<!-- HEADER — redesign avec bandeau coloré professionnel          -->
		<!-- ============================================================ -->
		<band height="200">

			<!-- ── BANDEAU HAUT pleine largeur (couleur primaire) ──────── -->
			<rectangle>
				<reportElement x="0" y="0" width="595" height="52" backcolor="#1E3A5F" uuid="hdr-bg-main"/>
				<graphicElement><pen lineWidth="0.0"/></graphicElement>
			</rectangle>
			<!-- accent strip décoratif -->
			<rectangle>
				<reportElement x="0" y="48" width="595" height="4" backcolor="#2563EB" uuid="hdr-accent"/>
				<graphicElement><pen lineWidth="0.0"/></graphicElement>
			</rectangle>

			<!-- Logo entreprise dans le bandeau -->
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" onErrorType="Blank">
				<reportElement x="8" y="4" width="64" height="44" uuid="hdr-logo"/>
				<imageExpression><![CDATA[$P{logoImage}]]></imageExpression>
			</image>

			<!-- Nom entreprise (blanc, grand) -->
			<textField isBlankWhenNull="true">
				<reportElement x="80" y="8" width="260" height="22" forecolor="#FFFFFF" uuid="hdr-nom-ent"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="14" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{nomEntreprise} != null ? $P{nomEntreprise}.toUpperCase() : ""]]></textFieldExpression>
			</textField>

			<!-- Activité / forme juridique sous le nom -->
			<textField isBlankWhenNull="true">
				<reportElement x="80" y="30" width="260" height="14" forecolor="#93C5FD" uuid="hdr-activite"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{activiteEntreprise} != null && !$P{activiteEntreprise}.trim().isEmpty() ? $P{activiteEntreprise} : "") + ($P{formeJuridique} != null && !$P{formeJuridique}.trim().isEmpty() ? ($P{activiteEntreprise} != null && !$P{activiteEntreprise}.trim().isEmpty() ? " — " : "") + $P{formeJuridique} : "")]]></textFieldExpression>
			</textField>

			<!-- Numéro de commande (grand, aligné à droite, dans le bandeau) -->
			<staticText>
				<reportElement x="345" y="6" width="110" height="11" forecolor="#93C5FD" uuid="hdr-label-cmd"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7" isBold="true"/>
				</textElement>
				<text><![CDATA[BON DE COMMANDE ACHAT]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="345" y="18" width="205" height="18" forecolor="#FFFFFF" uuid="hdr-numero-cmd"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="13" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{numeroCommande} != null ? $P{numeroCommande} : "-"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="345" y="36" width="205" height="11" forecolor="#7DD3FC" uuid="hdr-date-cmd"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5"/>
				</textElement>
				<textFieldExpression><![CDATA["Date : " + ($P{dateCommande} != null ? $P{dateCommande} : "-")]]></textFieldExpression>
			</textField>

			<!-- ── ZONE INFO (sous le bandeau) ──────────────────────────── -->
			<!-- Adresse entreprise (gauche) -->
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="58" width="270" height="11" forecolor="#475569" uuid="hdr-adresse-ent"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{adresseEntreprise} != null ? $P{adresseEntreprise} : ""]]></textFieldExpression>
			</textField>
			<!-- Identifiants entreprise -->
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="69" width="270" height="10" forecolor="#64748B" uuid="hdr-ids-ent"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="6.5"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{rcEntreprise} != null && !$P{rcEntreprise}.trim().isEmpty() ? "RC : " + $P{rcEntreprise} : "") +
($P{iceEntreprise} != null && !$P{iceEntreprise}.trim().isEmpty() ? "  |  ICE : " + $P{iceEntreprise} : "") +
($P{nifEntreprise} != null && !$P{nifEntreprise}.trim().isEmpty() ? "  |  IF : " + $P{nifEntreprise} : "")]]></textFieldExpression>
			</textField>

			<!-- ── BLOC COMMANDE (centre-gauche) ── -->
			<rectangle radius="4">
				<reportElement x="0" y="84" width="270" height="56" backcolor="#F0F9FF" uuid="hdr-cmd-bg"/>
				<graphicElement><pen lineWidth="0.8" lineColor="#BAE6FD"/></graphicElement>
			</rectangle>

			<!-- Livraison prévue -->
			<staticText>
				<reportElement x="8" y="88" width="90" height="9" forecolor="#0284C7" uuid="hdr-lbl-livr"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="6.5" isBold="true"/>
				</textElement>
				<text><![CDATA[LIVRAISON PRÉVUE]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="8" y="98" width="120" height="12" forecolor="#0F172A" uuid="hdr-val-livr"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{dateLivraisonPrevue} != null ? $P{dateLivraisonPrevue} : "À convenir"]]></textFieldExpression>
			</textField>

			<!-- Statut -->
			<staticText>
				<reportElement x="145" y="88" width="60" height="9" forecolor="#0284C7" uuid="hdr-lbl-statut"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="6.5" isBold="true"/>
				</textElement>
				<text><![CDATA[STATUT]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="145" y="98" width="115" height="12" forecolor="#0F172A" uuid="hdr-val-statut"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{statut} != null ? $P{statut} : "-"]]></textFieldExpression>
			</textField>

			<!-- Mode livraison (décoratif) -->
			<staticText>
				<reportElement x="8" y="116" width="252" height="10" forecolor="#64748B" uuid="hdr-mode-livr"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="6.5"/>
				</textElement>
				<text><![CDATA[Mode : Franco dépôt]]></text>
			</staticText>

			<!-- ── BLOC FOURNISSEUR (droite) ── -->
			<rectangle radius="4">
				<reportElement x="278" y="58" width="277" height="82" backcolor="#F0F9FF" uuid="hdr-frn-bg"/>
				<graphicElement><pen lineWidth="0.9" lineColor="#7DD3FC"/></graphicElement>
			</rectangle>

			<staticText>
				<reportElement x="290" y="63" width="100" height="11" forecolor="#0284C7" uuid="hdr-lbl-frn"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[FOURNISSEUR]]></text>
			</staticText>

			<textField isBlankWhenNull="true">
				<reportElement x="290" y="75" width="255" height="18" forecolor="#0F172A" uuid="hdr-nom-frn"/>
				<textElement verticalAlignment="Top">
					<font fontName="DejaVu Sans" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{fournisseurNom}]]></textFieldExpression>
			</textField>

			<textField isBlankWhenNull="true">
				<reportElement x="290" y="95" width="255" height="13" forecolor="#475569" uuid="hdr-tel-frn"/>
				<textElement verticalAlignment="Top">
					<font fontName="DejaVu Sans" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{fournisseurTelephone} != null && !$P{fournisseurTelephone}.trim().isEmpty() ? $P{fournisseurTelephone} : ""]]></textFieldExpression>
			</textField>

			<textField isBlankWhenNull="true">
				<reportElement x="290" y="108" width="255" height="13" forecolor="#475569" uuid="hdr-adr-frn"/>
				<textElement verticalAlignment="Top">
					<font fontName="DejaVu Sans" size="7.5"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{fournisseurAdresse} != null ? $P{fournisseurAdresse} : "-"]]></textFieldExpression>
			</textField>

			<textField isBlankWhenNull="true">
				<reportElement x="290" y="123" width="255" height="11" forecolor="#0F172A" uuid="hdr-ice-frn"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{fournisseurIce} != null && !$P{fournisseurIce}.trim().isEmpty() ? "ICE : " + $P{fournisseurIce} : ""]]></textFieldExpression>
			</textField>

			<!-- ligne de séparation avant le tableau -->
			<line>
				<reportElement x="0" y="147" width="555" height="1" forecolor="#2563EB" uuid="hdr-sep-line"/>
				<graphicElement><pen lineWidth="1.5"/></graphicElement>
			</line>
		</band>
	</pageHeader>

	<!-- ============================================================ -->
	<!-- EN-TÊTE DU TABLEAU                                           -->
	<!-- ============================================================ -->
	<columnHeader>
		<band height="26">
			<rectangle>
				<reportElement x="0" y="0" width="555" height="25" backcolor="#1E3A5F" uuid="col-hdr-bg"/>
				<graphicElement><pen lineWidth="0.0"/></graphicElement>
			</rectangle>
			<line>
				<reportElement x="0" y="25" width="555" height="1" forecolor="#2563EB" uuid="col-hdr-line"/>
				<graphicElement><pen lineWidth="1.0"/></graphicElement>
			</line>

			<staticText>
				<reportElement x="4" y="0" width="72" height="25" forecolor="#93C5FD" uuid="col-reference"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[RÉFÉRENCE]]></text>
			</staticText>
			<staticText>
				<reportElement x="80" y="0" width="156" height="25" forecolor="#FFFFFF" uuid="col-designation"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[DÉSIGNATION]]></text>
			</staticText>
			<staticText>
				<reportElement x="240" y="0" width="55" height="25" forecolor="#FFFFFF" uuid="col-qte"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[QTÉ]]></text>
			</staticText>
			<staticText>
				<reportElement x="300" y="0" width="60" height="25" forecolor="#FFFFFF" uuid="col-puht"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[P.U. HT]]></text>
			</staticText>
			<staticText>
				<reportElement x="365" y="0" width="45" height="25" forecolor="#93C5FD" uuid="col-tva"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[TVA]]></text>
			</staticText>
			<staticText>
				<reportElement x="415" y="0" width="60" height="25" forecolor="#FFFFFF" uuid="col-puttc"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[P.U. TTC]]></text>
			</staticText>
			<staticText>
				<reportElement x="480" y="0" width="71" height="25" forecolor="#FFFFFF" uuid="col-total"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[TOTAL]]></text>
			</staticText>
		</band>
	</columnHeader>

	<!-- ============================================================ -->
	<!-- LIGNES DETAIL                                                -->
	<!-- ============================================================ -->
	<detail>
		<band height="26">
			<rectangle>
				<reportElement style="zebra" stretchType="RelativeToBandHeight" x="0" y="0" width="555" height="25" uuid="det-bg"/>
				<graphicElement><pen lineWidth="0.0"/></graphicElement>
			</rectangle>
			<line>
				<reportElement positionType="FixRelativeToBottom" x="0" y="25" width="555" height="1" forecolor="#E2E8F0" uuid="det-line"/>
				<graphicElement><pen lineWidth="0.5"/></graphicElement>
			</line>

			<!-- Référence -->
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="4" y="0" width="72" height="25" forecolor="#2563EB" uuid="det-reference"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{reference} != null ? $F{reference} : ""]]></textFieldExpression>
			</textField>

			<!-- Désignation en MAJUSCULES -->
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="80" y="0" width="156" height="25" forecolor="#0F172A" uuid="det-design"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{designation} != null ? $F{designation}.toUpperCase() : ""]]></textFieldExpression>
			</textField>

			<!-- Quantité -->
			<textField pattern="#,##0.##" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="240" y="0" width="55" height="25" forecolor="#0F172A" uuid="det-qte"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{quantite} != null ? $F{quantite} : ($F{quantiteCommandee} != null ? $F{quantiteCommandee} : java.math.BigDecimal.ZERO)]]></textFieldExpression>
			</textField>

			<!-- P.U. HT -->
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="300" y="0" width="60" height="25" forecolor="#475569" uuid="det-puht"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{prixUnitaireHT} != null ? $F{prixUnitaireHT} : ($F{prixUnitaire} != null ? $F{prixUnitaire} : java.math.BigDecimal.ZERO)]]></textFieldExpression>
			</textField>

			<!-- TVA % -->
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="365" y="0" width="45" height="25" forecolor="#2563EB" uuid="det-tva"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{tauxTVA} != null ? String.valueOf($F{tauxTVA}.setScale(0, java.math.RoundingMode.HALF_UP)) + " %" : "20 %"]]></textFieldExpression>
			</textField>

			<!-- P.U. TTC -->
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="415" y="0" width="60" height="25" forecolor="#475569" uuid="det-puttc"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{prixUnitaireHT} != null ? $F{prixUnitaireHT} : ($F{prixUnitaire} != null ? $F{prixUnitaire} : java.math.BigDecimal.ZERO)).multiply(java.math.BigDecimal.ONE.add(($F{tauxTVA} != null ? $F{tauxTVA} : new java.math.BigDecimal("20.00")).divide(new java.math.BigDecimal("100.00"), 4, java.math.RoundingMode.HALF_UP)))]]></textFieldExpression>
			</textField>

			<!-- TOTAL ligne -->
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="480" y="0" width="71" height="25" forecolor="#0F172A" uuid="det-total"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{montantTTC} != null ? $F{montantTTC} : ($F{montantTotal} != null ? $F{montantTotal} : ($F{montantHT} != null ? $F{montantHT} : ($F{prixUnitaire} != null ? $F{prixUnitaire} : java.math.BigDecimal.ZERO).multiply($F{quantite} != null ? $F{quantite} : ($F{quantiteCommandee} != null ? $F{quantiteCommandee} : java.math.BigDecimal.ZERO))))]]></textFieldExpression>
			</textField>
		</band>
	</detail>

	<!-- ============================================================ -->
	<!-- PIED DE PAGE INTERMÉDIAIRE                                   -->
	<!-- ============================================================ -->
	<pageFooter>
		<band height="68">
			<line>
				<reportElement x="0" y="0" width="555" height="1" forecolor="#2563EB" uuid="pf-line-top"/>
				<graphicElement><pen lineWidth="1.5"/></graphicElement>
			</line>
			<!-- Nom entreprise + page -->
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="5" width="420" height="11" forecolor="#0F172A" uuid="pf-nom"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{nomEntreprise} != null ? $P{nomEntreprise}.toUpperCase() : "") +
($P{formeJuridique} != null && !$P{formeJuridique}.trim().isEmpty() ? " — " + $P{formeJuridique} : "") +
($P{capitalSocial} != null && !$P{capitalSocial}.trim().isEmpty() ? " | Capital : " + $P{capitalSocial} : "")]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="425" y="5" width="65" height="11" forecolor="#475569" uuid="pf-page-lbl"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5"/>
				</textElement>
				<textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " / "]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement x="490" y="5" width="65" height="11" forecolor="#475569" uuid="pf-page-tot"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5"/>
				</textElement>
				<textFieldExpression><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
			<!-- RC / IF / ICE / CNSS -->
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="17" width="555" height="10" forecolor="#334155" uuid="pf-ids"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="6.5"/>
				</textElement>
				<textFieldExpression><![CDATA["RC : " + ($P{rcEntreprise} != null && !$P{rcEntreprise}.isEmpty() ? $P{rcEntreprise} : "-") + ($P{tribunalRc} != null && !$P{tribunalRc}.trim().isEmpty() ? " (" + $P{tribunalRc} + ")" : "") +
"  |  IF : " + ($P{nifEntreprise} != null && !$P{nifEntreprise}.isEmpty() ? $P{nifEntreprise} : "-") +
"  |  PATENTE : " + ($P{patenteEntreprise} != null && !$P{patenteEntreprise}.isEmpty() ? $P{patenteEntreprise} : "-") +
"  |  ICE : " + ($P{iceEntreprise} != null && !$P{iceEntreprise}.isEmpty() ? $P{iceEntreprise} : "-") +
"  |  CNSS : " + ($P{cnssEntreprise} != null && !$P{cnssEntreprise}.isEmpty() ? $P{cnssEntreprise} : "-")]]></textFieldExpression>
			</textField>
			<!-- Tél / Email -->
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="28" width="555" height="10" forecolor="#334155" uuid="pf-contact"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="6.5"/>
				</textElement>
				<textFieldExpression><![CDATA["Siège : " + ($P{adresseEntreprise} != null ? $P{adresseEntreprise} : "") +
($P{telephoneEntreprise} != null && !$P{telephoneEntreprise}.isEmpty() ? "  |  Tél : " + $P{telephoneEntreprise} : "") +
($P{emailEntreprise} != null && !$P{emailEntreprise}.trim().isEmpty() ? "  |  Email : " + $P{emailEntreprise} : "")]]></textFieldExpression>
			</textField>
			<!-- Banque / RIB -->
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="39" width="555" height="10" forecolor="#334155" uuid="pf-banque"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="6.5"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{banqueEntreprise} != null && !$P{banqueEntreprise}.trim().isEmpty() ? "Banque : " + $P{banqueEntreprise} : "") +
($P{ribEntreprise} != null && !$P{ribEntreprise}.trim().isEmpty() ? "  |  RIB : " + $P{ribEntreprise} : "")]]></textFieldExpression>
			</textField>
			<!-- Pied de page personnalisé -->
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="50" width="555" height="10" forecolor="#64748B" uuid="pf-pied"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="6.5" isItalic="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{piedPage} != null ? $P{piedPage} : ""]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>

	<!-- ============================================================ -->
	<!-- DERNIÈRE PAGE — Totaux + Signature                           -->
	<!-- ============================================================ -->
	<lastPageFooter>
		<band height="258">

			<!-- ── CARTE CACHET & SIGNATURE (gauche) ────────────────────── -->
			<rectangle radius="6">
				<reportElement x="0" y="6" width="272" height="155" backcolor="#FFFFFF" uuid="card-sig-bg"/>
				<graphicElement><pen lineWidth="0.8" lineColor="#CBD5E1"/></graphicElement>
			</rectangle>

			<!-- Titre de la carte -->
			<staticText>
				<reportElement x="12" y="14" width="180" height="14" forecolor="#1E3A5F" uuid="card-sig-title"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8.5" isBold="true"/>
				</textElement>
				<text><![CDATA[CACHET & SIGNATURE]]></text>
			</staticText>

			<!-- Ligne de séparation sous le titre -->
			<line>
				<reportElement x="12" y="31" width="248" height="1" forecolor="#E2E8F0" uuid="card-sig-sep"/>
				<graphicElement><pen lineWidth="0.5"/></graphicElement>
			</line>

			<!-- Mentions -->
			<staticText>
				<reportElement x="12" y="36" width="248" height="11" forecolor="#64748B" uuid="card-sig-info1"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7"/>
				</textElement>
				<text><![CDATA[Nom & Signature : ...........................................................]]></text>
			</staticText>
			<staticText>
				<reportElement x="12" y="49" width="248" height="11" forecolor="#64748B" uuid="card-sig-info2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7"/>
				</textElement>
				<text><![CDATA[Date : ...................................  Visa / Bon pour accord]]></text>
			</staticText>

			<!-- Cadre en pointillés pour le cachet -->
			<rectangle radius="4">
				<reportElement x="12" y="65" width="248" height="88" backcolor="#F8FAFC" uuid="card-sig-zone"/>
				<graphicElement><pen lineWidth="0.75" lineStyle="Dashed" lineColor="#94A3B8"/></graphicElement>
			</rectangle>

			<staticText>
				<reportElement x="16" y="136" width="240" height="12" forecolor="#94A3B8" uuid="card-sig-hint"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="6" isItalic="true"/>
				</textElement>
				<text><![CDATA[Emplacement réservé au cachet et à la signature]]></text>
			</staticText>

			<!-- ── CARTE RÉCAPITULATIF / TOTAUX (droite) ───────────────── -->
			<rectangle radius="6">
				<reportElement x="283" y="6" width="272" height="155" backcolor="#F8FAFC" uuid="card-tot-bg"/>
				<graphicElement><pen lineWidth="0.8" lineColor="#CBD5E1"/></graphicElement>
			</rectangle>

			<!-- Titre de la carte -->
			<staticText>
				<reportElement x="295" y="14" width="180" height="14" forecolor="#1E3A5F" uuid="card-tot-title"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8.5" isBold="true"/>
				</textElement>
				<text><![CDATA[RÉCAPITULATIF]]></text>
			</staticText>

			<!-- Ligne de séparation sous le titre -->
			<line>
				<reportElement x="295" y="31" width="248" height="1" forecolor="#E2E8F0" uuid="card-tot-sep"/>
				<graphicElement><pen lineWidth="0.5"/></graphicElement>
			</line>

			<!-- Ligne TOTAL HT -->
			<staticText>
				<reportElement x="295" y="36" width="100" height="13" forecolor="#475569" uuid="card-tot-ht-lbl"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5"/>
				</textElement>
				<text><![CDATA[TOTAL HT]]></text>
			</staticText>
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement x="395" y="36" width="148" height="13" forecolor="#0F172A" uuid="card-tot-ht-val"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8.5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{montantHT} != null ? $P{montantHT} : ($P{montantTotal} != null ? $P{montantTotal} : java.math.BigDecimal.ZERO)]]></textFieldExpression>
			</textField>

			<!-- Séparateur -->
			<line>
				<reportElement x="295" y="50" width="248" height="1" forecolor="#E2E8F0" uuid="card-tot-sep-mid"/>
				<graphicElement><pen lineWidth="0.5"/></graphicElement>
			</line>

			<!-- Ligne TVA -->
			<staticText>
				<reportElement x="295" y="53" width="100" height="13" forecolor="#475569" uuid="card-tot-tva-lbl"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5"/>
				</textElement>
				<text><![CDATA[TVA]]></text>
			</staticText>
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement x="395" y="53" width="148" height="13" forecolor="#0F172A" uuid="card-tot-tva-val"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="8.5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{montantTVA} != null ? $P{montantTVA} : java.math.BigDecimal.ZERO]]></textFieldExpression>
			</textField>

			<!-- Bloc TOTAL TTC mis en valeur -->
			<rectangle radius="5">
				<reportElement x="293" y="70" width="252" height="42" backcolor="#1E3A5F" uuid="card-tot-ttc-box"/>
				<graphicElement><pen lineWidth="0.0"/></graphicElement>
			</rectangle>
			<textField isBlankWhenNull="true">
				<reportElement x="297" y="73" width="244" height="11" forecolor="#93C5FD" uuid="card-tot-ttc-lbl"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["TOTAL TTC (" + ($P{devise} != null ? $P{devise} : "MAD") + ")"]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement x="297" y="85" width="244" height="23" forecolor="#FFFFFF" uuid="card-tot-ttc-val"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="13" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{montantTTC} != null ? $P{montantTTC} : ($P{montantTotal} != null ? $P{montantTotal} : java.math.BigDecimal.ZERO)]]></textFieldExpression>
			</textField>

			<!-- Montant en toutes lettres -->
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="293" y="116" width="252" height="38" forecolor="#475569" uuid="card-tot-lettres"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="6.5" isItalic="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{montantEnLettres} != null && !$P{montantEnLettres}.trim().isEmpty() ? "Arrêté le présent bon de commande à la somme de :\n" + $P{montantEnLettres} : ""]]></textFieldExpression>
			</textField>

			<!-- ── PIED DE PAGE DERNIÈRE PAGE ─────────────────────────── -->
			<line>
				<reportElement x="0" y="168" width="555" height="1" forecolor="#2563EB" uuid="lpf-line"/>
				<graphicElement><pen lineWidth="1.5"/></graphicElement>
			</line>

			<textField isBlankWhenNull="true">
				<reportElement x="0" y="173" width="420" height="11" forecolor="#0F172A" uuid="lpf-nom"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{nomEntreprise} != null ? $P{nomEntreprise}.toUpperCase() : "") +
($P{formeJuridique} != null && !$P{formeJuridique}.trim().isEmpty() ? " — " + $P{formeJuridique} : "") +
($P{capitalSocial} != null && !$P{capitalSocial}.trim().isEmpty() ? " | Capital : " + $P{capitalSocial} : "")]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="425" y="173" width="65" height="11" forecolor="#475569" uuid="lpf-page-lbl"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5"/>
				</textElement>
				<textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " / "]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement x="490" y="173" width="65" height="11" forecolor="#475569" uuid="lpf-page-tot"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="7.5"/>
				</textElement>
				<textFieldExpression><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>

			<textField isBlankWhenNull="true">
				<reportElement x="0" y="185" width="555" height="10" forecolor="#334155" uuid="lpf-ids"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="6.5"/>
				</textElement>
				<textFieldExpression><![CDATA["RC : " + ($P{rcEntreprise} != null && !$P{rcEntreprise}.isEmpty() ? $P{rcEntreprise} : "-") + ($P{tribunalRc} != null && !$P{tribunalRc}.trim().isEmpty() ? " (" + $P{tribunalRc} + ")" : "") +
"  |  IF : " + ($P{nifEntreprise} != null && !$P{nifEntreprise}.isEmpty() ? $P{nifEntreprise} : "-") +
"  |  PATENTE : " + ($P{patenteEntreprise} != null && !$P{patenteEntreprise}.isEmpty() ? $P{patenteEntreprise} : "-") +
"  |  ICE : " + ($P{iceEntreprise} != null && !$P{iceEntreprise}.isEmpty() ? $P{iceEntreprise} : "-") +
"  |  CNSS : " + ($P{cnssEntreprise} != null && !$P{cnssEntreprise}.isEmpty() ? $P{cnssEntreprise} : "-")]]></textFieldExpression>
			</textField>

			<textField isBlankWhenNull="true">
				<reportElement x="0" y="196" width="555" height="10" forecolor="#334155" uuid="lpf-contact"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="6.5"/>
				</textElement>
				<textFieldExpression><![CDATA["Siège : " + ($P{adresseEntreprise} != null ? $P{adresseEntreprise} : "") +
($P{telephoneEntreprise} != null && !$P{telephoneEntreprise}.isEmpty() ? "  |  Tél : " + $P{telephoneEntreprise} : "") +
($P{emailEntreprise} != null && !$P{emailEntreprise}.trim().isEmpty() ? "  |  Email : " + $P{emailEntreprise} : "")]]></textFieldExpression>
			</textField>

			<textField isBlankWhenNull="true">
				<reportElement x="0" y="207" width="555" height="10" forecolor="#334155" uuid="lpf-banque"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="6.5"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{banqueEntreprise} != null && !$P{banqueEntreprise}.trim().isEmpty() ? "Banque : " + $P{banqueEntreprise} : "") +
($P{ribEntreprise} != null && !$P{ribEntreprise}.trim().isEmpty() ? "  |  RIB : " + $P{ribEntreprise} : "")]]></textFieldExpression>
			</textField>

			<textField isBlankWhenNull="true">
				<reportElement x="0" y="218" width="555" height="10" forecolor="#64748B" uuid="lpf-pied"/>
				<textElement verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="6.5" isItalic="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{piedPage} != null ? $P{piedPage} : ""]]></textFieldExpression>
			</textField>

		</band>
	</lastPageFooter>
</jasperReport>
