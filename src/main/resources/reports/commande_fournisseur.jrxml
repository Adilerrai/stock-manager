<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="commande_fournisseur" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="logoImage" class="java.awt.Image"/>
    <parameter name="nomEntreprise" class="java.lang.String"/>
    <parameter name="activiteEntreprise" class="java.lang.String"/>
    <parameter name="adresseEntreprise" class="java.lang.String"/>
    <parameter name="telephoneEntreprise" class="java.lang.String"/>
    <parameter name="rcEntreprise" class="java.lang.String"/>
    <parameter name="nifEntreprise" class="java.lang.String"/>
    <parameter name="piedPage" class="java.lang.String"/>
    <parameter name="devise" class="java.lang.String"/>

    <parameter name="numeroCommande" class="java.lang.String"/>
    <parameter name="dateCommande" class="java.lang.String"/>
    <parameter name="dateLivraisonPrevue" class="java.lang.String"/>
    <parameter name="statut" class="java.lang.String"/>
    <parameter name="fournisseurNom" class="java.lang.String"/>
    <parameter name="fournisseurTelephone" class="java.lang.String"/>
    <parameter name="fournisseurAdresse" class="java.lang.String"/>
    <parameter name="montantTotal" class="java.math.BigDecimal"/>
    <parameter name="observations" class="java.lang.String"/>

    <field name="reference" class="java.lang.String"/>
    <field name="designation" class="java.lang.String"/>
    <field name="quantite" class="java.math.BigDecimal"/>
    <field name="prixUnitaire" class="java.math.BigDecimal"/>
    <field name="montantTotal" class="java.math.BigDecimal"/>

    <title>
        <band height="175">
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="0" y="0" width="130" height="65"/>
                <imageExpression><![CDATA[$P{logoImage}]]></imageExpression>
            </image>

            <textField isBlankWhenNull="true">
                <reportElement x="140" y="0" width="230" height="18"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{nomEntreprise}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="140" y="18" width="230" height="13" forecolor="#444444"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{activiteEntreprise}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="140" y="31" width="230" height="13" forecolor="#444444"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{adresseEntreprise} + " - Tél: " + $P{telephoneEntreprise}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="140" y="44" width="230" height="13" forecolor="#444444"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA["RC: " + ($P{rcEntreprise} != null ? $P{rcEntreprise} : "-") + " | NIF: " + ($P{nifEntreprise} != null ? $P{nifEntreprise} : "-")]]></textFieldExpression>
            </textField>

            <!-- Titre Monochrome Pro -->
            <rectangle radius="3">
                <reportElement x="375" y="0" width="180" height="65" backcolor="#1F2937"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="380" y="6" width="170" height="18" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[BON DE COMMANDE]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="380" y="24" width="170" height="16" forecolor="#F9FAFB"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{numeroCommande}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="380" y="42" width="170" height="14" forecolor="#E5E7EB"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA["Date: " + $P{dateCommande}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="75" width="555" height="1" forecolor="#CCCCCC"/>
                <graphicElement><pen lineWidth="1"/></graphicElement>
            </line>

            <rectangle radius="3">
                <reportElement x="0" y="85" width="265" height="80" backcolor="#F9FAFB"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D1D5DB"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="90" width="150" height="15" forecolor="#111827"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[CONDITIONS LIVRAISON]]></text>
            </staticText>
            <staticText>
                <reportElement x="10" y="108" width="90" height="14" forecolor="#4B5563"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[Livraison prévue :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="108" width="155" height="14"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{dateLivraisonPrevue} != null ? $P{dateLivraisonPrevue} : "À convenir"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="10" y="125" width="90" height="14" forecolor="#4B5563"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[Statut :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="125" width="155" height="14"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{statut} != null ? $P{statut} : "TRANSMISE"]]></textFieldExpression>
            </textField>

            <rectangle radius="3">
                <reportElement x="285" y="85" width="270" height="80" backcolor="#F9FAFB"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D1D5DB"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="295" y="90" width="100" height="15" forecolor="#111827"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[FOURNISSEUR :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="295" y="108" width="250" height="15"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{fournisseurNom}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="295" y="123" width="250" height="14" forecolor="#4B5563"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{fournisseurAdresse} != null ? $P{fournisseurAdresse} : ""]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="295" y="138" width="250" height="14" forecolor="#4B5563"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA["Téléphone: " + ($P{fournisseurTelephone} != null ? $P{fournisseurTelephone} : "-")]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="24" backcolor="#1F2937"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="5" y="0" width="90" height="24" forecolor="#FFFFFF"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[RÉFÉRENCE]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="0" width="240" height="24" forecolor="#FFFFFF"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[DÉSIGNATION MARCHANDISE]]></text>
            </staticText>
            <staticText>
                <reportElement x="345" y="0" width="55" height="24" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[QTÉ]]></text>
            </staticText>
            <staticText>
                <reportElement x="405" y="0" width="65" height="24" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[P.U. HT]]></text>
            </staticText>
            <staticText>
                <reportElement x="475" y="0" width="75" height="24" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <line>
                <reportElement x="0" y="19" width="555" height="1" forecolor="#E5E7EB"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="5" y="2" width="90" height="16"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{reference}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="2" width="240" height="16"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{designation}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="345" y="2" width="55" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{quantite}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="405" y="2" width="65" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{prixUnitaire}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="475" y="2" width="75" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{montantTotal}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <line>
                <reportElement x="0" y="0" width="555" height="1" forecolor="#CCCCCC"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="3" width="450" height="16" forecolor="#666666"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="7" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{piedPage}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="455" y="3" width="100" height="16" forecolor="#666666"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Last Page Footer : DOCKÉ EN BAS -->
    <lastPageFooter>
        <band height="125">
            <!-- Instructions (Gauche) -->
            <rectangle radius="3">
                <reportElement x="0" y="5" width="280" height="75" backcolor="#F9FAFB"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D1D5DB"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="10" width="150" height="14" forecolor="#111827"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[VISA &amp; VALIDATION ACHATS]]></text>
            </staticText>
            <staticText>
                <reportElement x="10" y="55" width="260" height="15" forecolor="#6B7280"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="7" isItalic="true"/></textElement>
                <text><![CDATA[Cachet et Signature de la direction]]></text>
            </staticText>

            <!-- Total (Droite) -->
            <rectangle radius="3">
                <reportElement x="300" y="5" width="255" height="75" backcolor="#F9FAFB"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D1D5DB"/></graphicElement>
            </rectangle>
            <rectangle radius="2">
                <reportElement x="305" y="20" width="245" height="40" backcolor="#1F2937"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="315" y="30" width="100" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true"/></textElement>
                <text><![CDATA[TOTAL COMMANDE :]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="415" y="30" width="130" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{montantTotal} + " " + $P{devise}]]></textFieldExpression>
            </textField>

            <!-- Pied de page -->
            <line>
                <reportElement x="0" y="100" width="555" height="1" forecolor="#CCCCCC"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="103" width="450" height="18" forecolor="#666666"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="7" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{piedPage}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="455" y="103" width="100" height="18" forecolor="#666666"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </lastPageFooter>
</jasperReport>
