($P{fournisseurTelephone} != null && !$P{fournisseurTelephone}.isEmpty() ? "Tél : " + $P{fournisseurTelephone} + "<br/>" : "") +
($P{fournisseurIce} != null && !$P{fournisseurIce}.isEmpty() ? "<b>ICE :</b> " + $P{fournisseurIce} : "")]]></textFieldExpression>
