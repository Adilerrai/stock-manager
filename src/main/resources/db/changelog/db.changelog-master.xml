<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 
      Fichier maître Liquibase (db.changelog-master.xml)
      Chaque migration ou évolution de schéma est isolée dans son propre fichier sous le dossier 'changes/'.
    -->

    <!-- Changeset 001 : Baseline Initial Schema & Data (db.sql) -->
    <include file="changes/001-initial-schema-and-seed.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 002 : Colonnes manquantes table stocks & multi-tenant -->
    <include file="changes/002-add-stocks-missing-columns.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 003 : Table codifications_document et unicité par tenant -->
    <include file="changes/003-create-codifications-and-update-unique-constraints.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 004 : Ajout prix_vente_min dans produits -->
    <include file="changes/004-add-produits-prix-vente-min.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 005 : Conversion de la colonne genre dans users en VARCHAR(20) -->
    <include file="changes/005-alter-users-genre-to-varchar.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 006 (Sprint 1) : Commandes, Tarifs, Reliquats et Historique des Prix -->
    <include file="changes/006-sprint1-commandes-tarifs-reservations.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 007 : Mise à jour contrainte statut commandes_client (BACKORDER, etc.) -->
    <include file="changes/007-fix-commandes-client-statut-check.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 008 : Mise à jour contraintes statut livraison (PARTIELLE) -->
    <include file="changes/008-fix-statut-livraison-check.xml" relativeToChangelogFile="true"/>

