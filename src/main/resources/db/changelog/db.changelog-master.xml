    <include file="changes/010-add-modifie-par-nom-historique-prix.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 011 : Unicité référence produit par point_de_vente_id / tenant -->
    <include file="changes/011-update-produits-unique-constraint-tenant.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 012 : Table de liaison multi-commandes pour bons_livraison_client -->
    <include file="changes/012-create-bl-client-commandes.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 013 : Colonnes Maroc (patente, ice, cnss, gsm) entreprise_profiles -->
    <include file="changes/013-add-entreprise-profiles-morocco-fields.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 014 : Liaison Tiers Fournisseur, Articles de charges et Passerelle Comptable dans depenses -->
    <include file="changes/014-add-depenses-fournisseur-articles-passerelle.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 015 : Règles Métier ERP configurables dans entreprise_profiles -->
    <include file="changes/015-add-entreprise-profiles-business-rules.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 016 : Nature de l'avoir et flexibilité lignes_avoir -->
    <include file="changes/016-add-nature-avoir-and-lignes-avoir-flexibility.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 017 : Support de l'attachement documentaire (PDF/Images) pour Commandes Clients et BL Fournisseur -->
    <include file="changes/017-add-documents-comptables-commande-and-livraison.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 018 : Support de l'attachement documentaire (PDF/Images) pour Chèques, Traites et Effets -->
    <include file="changes/018-add-documents-comptables-cheque-effet.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 019 : Ajout colonne motif_retour dans lignes_avoir -->
    <include file="changes/019-add-motif-retour-to-lignes-avoir.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 020 : Ajout colonne must_change_password dans users -->
    <include file="changes/020-add-must-change-password-to-users.xml" relativeToChangelogFile="true"/>

    <!-- Changeset 021 : Assouplissement contrainte fk_users_mere -->
    <include file="changes/021-drop-fk-users-mere.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
