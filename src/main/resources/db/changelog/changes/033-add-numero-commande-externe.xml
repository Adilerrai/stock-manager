<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
    logicalFilePath="db/changelog/db.changelog-master.xml">

    <!-- 
      Changeset 033 : Ajout de la colonne numero_commande_externe dans la table commandes_client
                      pour séparer le numéro interne (généré par le système) et le numéro externe (client / OCR)
    -->
    <changeSet id="033-add-numero-commande-externe" author="erp-pointvente">
        <sql splitStatements="false">
            DO $$
            BEGIN
                IF NOT EXISTS (
                    SELECT 1 
                    FROM information_schema.columns 
                    WHERE table_name = 'commandes_client' AND column_name = 'numero_commande_externe'
                ) THEN
                    ALTER TABLE commandes_client ADD COLUMN numero_commande_externe VARCHAR(100);
                END IF;
            END $$;
        </sql>
    </changeSet>
</databaseChangeLog>
