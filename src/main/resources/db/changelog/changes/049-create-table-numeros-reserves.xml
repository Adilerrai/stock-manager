<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="049-create-table-numeros-reserves" author="antigravity">
        <createTable tableName="numeros_reserves">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="point_de_vente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="type_document" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="numero" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="valeur_sequence" type="BIGINT"/>
            <column name="statut" type="VARCHAR(30)" defaultValue="DISPONIBLE">
                <constraints nullable="false"/>
            </column>
            <column name="motif_liberation" type="VARCHAR(255)"/>
            <column name="document_origine_id" type="BIGINT"/>
            <column name="document_origine_type" type="VARCHAR(50)"/>
            <column name="date_reservation" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="date_utilisation" type="TIMESTAMP"/>
            <column name="document_utilisation_id" type="BIGINT"/>
        </createTable>

        <createIndex indexName="idx_num_res_tenant_type_statut" tableName="numeros_reserves">
            <column name="point_de_vente_id"/>
            <column name="type_document"/>
            <column name="statut"/>
        </createIndex>

        <createIndex indexName="idx_num_res_numero" tableName="numeros_reserves">
            <column name="numero"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
