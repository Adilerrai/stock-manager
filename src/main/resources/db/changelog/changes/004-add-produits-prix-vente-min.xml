<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
    logicalFilePath="db/changelog/db.changelog-master.xml">

    <!-- 
      Changeset 004 : Ajout de la colonne prix_vente_min dans la table produits
    -->
    <changeSet id="004-add-produits-prix-vente-min" author="erp-pointvente">
        <sql splitStatements="true">
            ALTER TABLE IF EXISTS produits ADD COLUMN IF NOT EXISTS prix_vente_min NUMERIC(15, 2) DEFAULT 0.00;
        </sql>
    </changeSet>

</databaseChangeLog>
