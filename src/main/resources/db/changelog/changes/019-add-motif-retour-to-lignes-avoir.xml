<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
    logicalFilePath="db/changelog/db.changelog-master.xml">

    <!-- 
      Changeset 019 : Ajout colonne motif_retour dans lignes_avoir
    -->
    <changeSet id="019-add-motif-retour-to-lignes-avoir" author="erp-pointvente">
        <sql splitStatements="false">
            ALTER TABLE IF EXISTS lignes_avoir 
                ADD COLUMN IF NOT EXISTS motif_retour VARCHAR(50) DEFAULT 'AUTRE';
        </sql>
    </changeSet>

</databaseChangeLog>
